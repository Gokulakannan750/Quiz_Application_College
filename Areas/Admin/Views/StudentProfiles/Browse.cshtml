@model Quiz_Application_College.ViewModels.StudentBrowseVm
@{
    ViewData["Title"] = "Students — Browse (Read-only)";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Students — Browse (Read-only)</h2>
        <a class="btn btn-outline-secondary" href="/Admin/StudentProfiles">Back</a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@Html.Raw(TempData["Ok"])</div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Err"])</div>
    }

    <!-- FILTERS -->
    <form method="get" action="/Admin/StudentProfiles/Browse" class="card shadow-sm mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label class="form-label">College</label>
                <select name="College" id="collegeSelect" class="form-select" asp-items="Model.CollegeOptions">
                    <option value="">All</option>
                </select>
                <script>(() => { const s=document.getElementById('collegeSelect'); if(s) s.value='@Model.College'; })();</script>
            </div>
            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="Department" id="deptSelect" class="form-select" asp-items="Model.DepartmentOptions">
                    <option value="">All</option>
                </select>
                <script>(() => { const s=document.getElementById('deptSelect'); if(s) s.value='@Model.Department'; })();</script>
            </div>
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input name="Search" value="@Model.Search" class="form-control" placeholder="name / roll / email" />
            </div>
        </div>
        <div class="card-footer d-flex gap-2 align-items-center">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a class="btn btn-outline-secondary" href="/Admin/StudentProfiles/Browse">Clear</a>
        </div>
    </form>

    <!-- RESULT TABLE -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>College</th>
                            <th>Dept</th>
                            <th>Roll</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>MCQ Enrollments</th>
                            <th>Coding Enrollments</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows != null && Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td>@r.College</td>
                                    <td>@r.Department</td>
                                    <td>@r.RollNumber</td>
                                    <td>@r.Name</td>
                                    <td>@r.Email</td>
                                    <td>
                                        @if (r.McqQuizzes.Any())
                                        {
                                            foreach (var t in r.McqQuizzes.Take(3))
                                            {
                                                <span class="badge bg-success me-1">@t</span>
                                            }
                                            @if (r.McqQuizzes.Count > 3)
                                            {
                                                <span class="badge bg-success">+@(r.McqQuizzes.Count - 3) more</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (r.CodingQuizzes.Any())
                                        {
                                            foreach (var t in r.CodingQuizzes.Take(3))
                                            {
                                                <span class="badge bg-primary me-1">@t</span>
                                            }
                                            @if (r.CodingQuizzes.Count > 3)
                                            {
                                                <span class="badge bg-primary">+@(r.CodingQuizzes.Count - 3) more</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@r.CreatedAt</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted">No students found for this filter.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div>Showing @(Model.Rows?.Count ?? 0) of @Model.Total</div>
                <div class="btn-group">
                    @{
                        int last = (int)Math.Ceiling((double)Math.Max(Model.Total, 1) / Math.Max(Model.PageSize, 1));
                        int prev = Math.Max(1, Model.Page - 1);
                        int next = Math.Min(last, Model.Page + 1);
                        string baseUrl = Url.Content("~/Admin/StudentProfiles/Browse");
                        string qBase = $"?College={Model.College}&Department={Model.Department}&Search={Model.Search}&PageSize={Model.PageSize}";
                    }
                    <a class="btn btn-outline-secondary btn-sm" href="@($"{baseUrl}{qBase}&Page=1")">First</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@($"{baseUrl}{qBase}&Page={prev}")">Prev</a>
                    <span class="btn btn-sm btn-outline-dark disabled">Page @Model.Page of @last</span>
                    <a class="btn btn-outline-secondary btn-sm" href="@($"{baseUrl}{qBase}&Page={next}")">Next</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@($"{baseUrl}{qBase}&Page={last}")">Last</a>
                </div>
            </div>
        </div>
    </div>
</div>
