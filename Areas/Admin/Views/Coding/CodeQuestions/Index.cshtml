@model IEnumerable<Quiz_Application_College.Domain.Coding.CodeQuestion>
@{
    ViewData["Title"] = "Coding Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Coding Questions</h3>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-area="Admin" asp-controller="CodeQuestions" asp-action="Create">New</a>
            <a class="btn btn-outline-secondary" href="/Admin/Coding">Back to Coding Dashboard</a>
        </div>
    </div>

    
    <form class="mt-3 mb-2" method="get">
        <div class="input-group">
            <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search title..." />
            <button class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    <table class="table table-sm table-striped align-middle mt-2">
        <thead>
            <tr>
                <th>Title</th>
                <th>Total marks</th>
                <th>Languages</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@q.Title</td>
                    <td>@q.MaxMarks</td>
                    <td>@q.AllowedLanguagesCsv</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="CodeQuestions" asp-action="Edit" asp-route-id="@q.Id">Edit</a>
                        <form asp-area="Admin" asp-controller="CodeQuestions" asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this coding question?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
