@model Quiz_Application_College.Domain.Coding.CodeQuestion
@{
    ViewData["Title"] = "Edit Coding Question";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cases = (Model?.TestCases ?? new List<Quiz_Application_College.Domain.Coding.CodeTestCase>()).ToList();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Edit Coding Question</h2>
        <a class="btn btn-outline-secondary" href="/Admin/Coding/CodeQuestions">Back</a>
    </div>

    <form method="post" action="/Admin/Coding/CodeQuestions/Edit/@Model.Id">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm">
            <div class="card-body">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Question</label>
                    <textarea asp-for="Questions" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Questions" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AllowedLanguagesCsv" class="form-label"></label>
                    <input asp-for="AllowedLanguagesCsv" class="form-control" />
                    <span asp-validation-for="AllowedLanguagesCsv" class="text-danger"></span>
                    <small class="text-muted">
                        Example: python,csharp,cpp. Marks will be calculated from testcase weights.
                    </small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Starter Code (JSON per language) — optional</label>
                    <textarea asp-for="StarterCodeJson" class="form-control" rows="4"></textarea>
                </div>

                <hr />
                <h6 class="mb-2">Test Cases</h6>

                <div id="cases">
                    @for (int i = 0; i < cases.Count; i++)
                    {
                        var tc = cases[i];
                        <div class="border rounded p-2 mb-2 case-item" data-index="@i">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Input</label>
                                    <textarea name="TestCases[@i].Input" class="form-control" rows="2">@tc.Input</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Expected Output</label>
                                    <textarea name="TestCases[@i].ExpectedOutput" class="form-control" rows="2">@tc.ExpectedOutput</textarea>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label mt-2">Weight</label>
                                    <input name="TestCases[@i].Weight" class="form-control" type="number" value="@tc.Weight" step="1" min="1" />
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <!-- Hidden false FIRST, then checkbox true -->
                                        <input class="form-check-input" type="checkbox" name="TestCases[@i].IsHidden" value="true" @(tc.IsHidden ? "checked" : "") />
                                        <input type="hidden" name="TestCases[@i].IsHidden" value="false" />
                                        <label class="form-check-label">Hidden</label>
                                    </div>
                                </div>
                                <div class="col-md-12 d-flex justify-content-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-case-btn">Remove</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Add button at the BOTTOM -->
                <div class="d-flex">
                    <button type="button" id="addCaseBtn" class="btn btn-sm btn-outline-primary ms-auto">Add test case</button>
                </div>

            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="/Admin/Coding/CodeQuestions">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
                (function () {
                    const casesEl = document.getElementById('cases');
                    const addBtn = document.getElementById('addCaseBtn');

                    function createCaseHtml(idx) {
                        return `
        <div class="border rounded p-2 mb-2 case-item" data-index="${idx}">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label">Input</label>
              <textarea name="TestCases[${idx}].Input" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label">Expected Output</label>
              <textarea name="TestCases[${idx}].ExpectedOutput" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-3">
              <label class="form-label mt-2">Weight</label>
              <input name="TestCases[${idx}].Weight" class="form-control" type="number" value="1" step="1" min="1" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <div class="form-check">
                <!-- Hidden false FIRST, then checkbox true -->
        <input class="form-check-input" type="checkbox" name="TestCases[__idx__].IsHidden" value="true" />
        <input type="hidden" name="TestCases[__idx__].IsHidden" value="false" />
                        <label class="form-check-label">Hidden</label>
              </div>
            </div>
            <div class="col-md-12 d-flex justify-content-end">
              <button type="button" class="btn btn-sm btn-outline-danger remove-case-btn">Remove</button>
            </div>
          </div>
        </div>`.trim();
                    }

                    function reindexCases() {
                        const items = casesEl.querySelectorAll('.case-item');
                        items.forEach((item, newIdx) => {
                            item.setAttribute('data-index', newIdx);
                            item.querySelectorAll('input[name], textarea[name]').forEach(el => {
                                el.name = el.name.replace(/TestCases\[\d+\]/, 'TestCases[' + newIdx + ']');
                            });
                        });
                    }

                    addBtn.addEventListener('click', () => {
                        const nextIdx = casesEl.querySelectorAll('.case-item').length;
                        const wrapper = document.createElement('div');
                        wrapper.innerHTML = createCaseHtml(nextIdx);
                        casesEl.appendChild(wrapper.firstChild);
                    });

                    casesEl.addEventListener('click', (e) => {
                        if (e.target && e.target.classList.contains('remove-case-btn')) {
                            const item = e.target.closest('.case-item');
                            if (item) {
                                item.remove();
                                reindexCases();
                            }
                        }
                    });
                })();
    </script>
}
