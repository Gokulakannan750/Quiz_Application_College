@model Quiz_Application_College.Areas.Admin.Controllers.Coding.CodingQuizController.ManageQuestionsVm
@{
    ViewData["Title"] = "Attach Coding Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Attach Coding Questions</h3>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Back</a>
    </div>
    <div class="text-muted">Quiz: <strong>@Model.QuizTitle</strong></div>

    <form method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="QuizId" />

        <div class="card">
            <div class="card-body">
                <p class="mb-2">Tick the coding question(s) for this quiz. (Students currently see the first by order.)</p>
                <div class="list-group">
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <label class="list-group-item d-flex align-items-center">
                            <input type="checkbox" class="form-check-input me-2" asp-for="Items[i].IsSelected" />
                            <span>@Model.Items[i].Title</span>
                            <input type="hidden" asp-for="Items[i].Id" />
                            <input type="hidden" asp-for="Items[i].Title" />
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancel</a>
        </div>
    </form>
</div>
