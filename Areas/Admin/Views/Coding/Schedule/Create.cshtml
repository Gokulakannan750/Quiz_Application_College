@model Quiz_Application_College.ViewModels.ScheduleCreateVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Coding Schedule";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Create Coding Schedule</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Programming Language -->
            <div class="mb-3">
                <label asp-for="ProgrammingLanguage" class="form-label">Programming Language</label>
                <select asp-for="ProgrammingLanguage"
                        asp-items="(SelectList)ViewBag.LanguageOptions"
                        class="form-select"
                        id="ProgrammingLanguage">
                    <option value="">-- Select Programming Language --</option>
                </select>
                <span asp-validation-for="ProgrammingLanguage" class="text-danger"></span>
            </div>

            <!-- Quiz (filtered by language) -->
            <div class="mb-3">
                <label asp-for="QuizId" class="form-label">Quiz</label>
                <select asp-for="QuizId"
                        asp-items="(SelectList)ViewBag.QuizOptions"
                        class="form-select"
                        id="QuizId">
                    <option value="">-- Select Coding Quiz --</option>
                </select>
                <span asp-validation-for="QuizId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartAt" class="form-label">Start At</label>
                    <input asp-for="StartAt" class="form-control" />
                    <span asp-validation-for="StartAt" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndAt" class="form-label">End At</label>
                    <input asp-for="EndAt" class="form-control" />
                    <span asp-validation-for="EndAt" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxAttempts" class="form-label">Max Attempts</label>
                    <input asp-for="MaxAttempts" class="form-control" />
                    <span asp-validation-for="MaxAttempts" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Timezone" class="form-label">Timezone</label>
                    <input asp-for="Timezone" class="form-control" placeholder="e.g., India Standard Time" />
                    <span asp-validation-for="Timezone" class="text-danger"></span>
                    <small class="text-muted">e.g., India Standard Time</small>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // When language changes, reload page with ?language=XYZ to filter quizzes
        (function () {
            var ddlLang = document.getElementById('ProgrammingLanguage');
            if (!ddlLang) return;

            ddlLang.addEventListener('change', function () {
                var lang = this.value;
                var url = '@Url.Action("Create", "CodingSchedule", new { area = "Admin" })';
                if (lang) {
                    url += '?language=' + encodeURIComponent(lang);
                }
                window.location.href = url;
            });
        })();
    </script>
}
