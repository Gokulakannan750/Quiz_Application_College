@model List<Quiz_Application_College.ViewModels.QuestionSelectVm>

@{
    ViewData["Title"] = "Select Questions — " + (ViewBag.QuizTitle ?? "");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Select Questions — @ViewBag.QuizTitle</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>

    <form asp-action="Questions" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@ViewBag.QuizId" />

        @{
            // Group by file name; show "Manual / No file" for null/empty
            var grouped = Model
            .GroupBy(q => string.IsNullOrWhiteSpace(q.SourceFileName)
            ? "Manual / No file"
            : q.SourceFileName)
            .OrderBy(g => g.Key)
            .ToList();

            var groupIndex = 0;
        }

        @foreach (var group in grouped)
        {
            var groupId = $"file-group-{groupIndex++}";

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <input type="checkbox"
                               class="form-check-input me-2 file-select-checkbox"
                               data-group-id="@groupId" />
                        <button type="button"
                                class="btn btn-link p-0 align-middle file-toggle"
                                data-bs-toggle="collapse"
                                data-bs-target="#@groupId"
                                aria-expanded="true"
                                aria-controls="@groupId">
                            @group.Key
                        </button>
                    </div>
                    <small class="text-muted">
                        @group.Count() question@(group.Count() == 1 ? "" : "s")
                    </small>
                </div>

                <div id="@groupId" class="collapse show">
                    <table class="table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="width:80px;">Use</th>
                                <th>Question</th>
                                <th style="width:100px;">Order</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               class="form-check-input question-checkbox"
                                               data-group-id="@groupId"
                                               name="selectedIds"
                                               value="@item.QuestionId"
                                               @(item.Selected ? "checked" : "") />
                                    </td>
                                    <td>@item.Text</td>
                                    <td>
                                        @if (item.Order.HasValue)
                                        {
                                            @item.Order.Value
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save Selection</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // File-level checkbox: select/deselect all questions in that group
            document.querySelectorAll('.file-select-checkbox').forEach(function (fileCb) {
                fileCb.addEventListener('change', function () {
                    var groupId = this.getAttribute('data-group-id');
                    var checked = this.checked;

                    document.querySelectorAll('.question-checkbox[data-group-id="' + groupId + '"]')
                        .forEach(function (qCb) {
                            qCb.checked = checked;
                        });
                });
            });

            // When individual question cbs change, optionally update file-level cb
            document.querySelectorAll('.question-checkbox').forEach(function (qCb) {
                qCb.addEventListener('change', function () {
                    var groupId = this.getAttribute('data-group-id');
                    var all = document.querySelectorAll('.question-checkbox[data-group-id="' + groupId + '"]');

                    var allChecked = true;
                    var anyChecked = false;

                    all.forEach(function (cb) {
                        if (cb.checked) anyChecked = true;
                        else allChecked = false;
                    });

                    var fileCb = document.querySelector('.file-select-checkbox[data-group-id="' + groupId + '"]');
                    if (fileCb) {
                        // we keep it simple: checked only if all are checked
                        fileCb.checked = allChecked && anyChecked;
                    }
                });
            });
        });
    </script>
}
