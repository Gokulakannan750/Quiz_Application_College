@model Quiz_Application_College.ViewModels.QuizCreateVm

@{
    ViewData["Title"] = "Create MCQ Quiz";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? folderId = ViewBag.FolderId as int?;
}

<h2 class="mb-4">Create MCQ Quiz</h2>

<form asp-action="Create" asp-route-folderId="@folderId" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <input asp-for="DurationMinutes" class="form-control" />
                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
            </div>

            <hr />

            <div class="form-check mb-3">
                <input asp-for="EnableNegativeMarking" class="form-check-input" />
                <label asp-for="EnableNegativeMarking" class="form-check-label"></label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NegativeMarkPerWrong" class="form-label"></label>
                <input asp-for="NegativeMarkPerWrong" class="form-control" />
                <span asp-validation-for="NegativeMarkPerWrong" class="text-danger"></span>
                <small class="form-text text-muted">
                    Example: 0.25 to deduct 0.25 marks for each wrong answer (when enabled).
                </small>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input asp-for="ShuffleQuestions" class="form-check-input" />
                        <label asp-for="ShuffleQuestions" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="ShuffleOptions" class="form-check-input" />
                        <label asp-for="ShuffleOptions" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input asp-for="ShowReviewOnSubmit" class="form-check-input" />
                        <label asp-for="ShowReviewOnSubmit" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="ShowScoreOnSubmit" class="form-check-input" />
                        <label asp-for="ShowScoreOnSubmit" class="form-check-label"></label>
                    </div>
                </div>
            </div>

        </div>

        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
