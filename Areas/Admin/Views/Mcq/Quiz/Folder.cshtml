@model Quiz_Application_College.Domain.McqQuizFolder
@using Quiz_Application_College.Domain

@{
    ViewData["Title"] = "MCQ Quizzes - " + Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@Model.Name</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="text-muted small">@Model.Description</div>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create"
               asp-route-folderId="@Model.Id"
               class="btn btn-primary">
                Create Quiz in this Folder
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Folders</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @{
                var quizzes = (Model.Quizzes ?? Enumerable.Empty<Quiz>())
                .Where(q => q.Type == QuizType.Mcq)
                .OrderByDescending(q => q.CreatedAt)
                .ToList();
            }

            @if (quizzes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Duration (min)</th>
                                <th>Total Marks</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th style="width: 320px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in quizzes)
                            {
                                <tr>
                                    <td class="fw-semibold">@q.Title</td>
                                    <td>@q.DurationMinutes</td>
                                    <td>@q.TotalMarks</td>
                                    <td>
                                        @if (q.IsPublished)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                    </td>
                                    <td>@q.CreatedAt.LocalDateTime.ToString("dd-MMM-yyyy HH:mm")</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-action="Edit"
                                               asp-route-id="@q.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Questions"
                                               asp-route-id="@q.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Questions
                                            </a>

                                            @if (q.IsPublished)
                                            {
                                                <form asp-action="Unpublish"
                                                      asp-route-id="@q.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-warning">
                                                        Unpublish
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Publish"
                                                      asp-route-id="@q.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        Publish
                                                    </button>
                                                </form>
                                            }

                                            <form asp-action="Delete"
                                                  asp-route-id="@q.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>
                                            </form>

                                            <a asp-area="Admin"
                                               asp-controller="QuizAnalytics"
                                               asp-action="Quiz"
                                               asp-route-quizId="@q.Id"
                                               class="btn btn-sm btn-outline-info">
                                                Analytics
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted text-center py-4">
                    No quizzes in this folder yet. Click <strong>Create Quiz in this Folder</strong> to add one.
                </div>
            }
        </div>
    </div>
</div>
