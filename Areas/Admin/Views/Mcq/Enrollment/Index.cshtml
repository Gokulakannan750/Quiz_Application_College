@model IEnumerable<Quiz_Application_College.ViewModels.EnrollmentSummaryVm>
@{
    ViewData["Title"] = "MCQ — Enrollments (Summary)";
    Layout = "~/Views/Shared/_Layout.cshtml"; // adjust if needed
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">@ViewData["Title"]</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-area="Admin" asp-controller="McqEnrollment" asp-action="Create">Enroll Students</a>
            <a class="btn btn-outline-secondary" href="/Admin/Mcq">Back to MCQ Dashboard</a>
        </div>
    </div>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info">@TempData["Info"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Quiz</th>
            <th>College</th>
            <th>Department</th>
            <th class="text-end">Total Students</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No enrollments found.</td></tr>
        }
        else
        {
            foreach (var row in Model)
            {
                <tr>
                    <td>@row.QuizTitle</td>
                    <td>@row.College</td>
                    <td>@row.Department</td>
                    <td class="text-end">@row.TotalStudents</td>
                    <td class="text-end">
                        <form asp-area="Admin"
                              asp-controller="McqEnrollment"
                              asp-action="DeleteGroup"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="quizId" value="@row.QuizId" />
                            <input type="hidden" name="college" value="@row.College" />
                            <input type="hidden" name="department" value="@row.Department" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('Delete all @row.TotalStudents enrollment(s) for this group?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
