@model Quiz_Application_College.ViewModels.QuestionImportVm

@{
    ViewData["Title"] = "Import MCQ Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Import MCQ Questions</h2>

        <div class="btn-group">
            <a asp-action="Template" class="btn btn-outline-primary">
                Download Template
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(excludePropertyErrors: true)
        </div>
    }

    @if (Model != null && Model.Errors.Any())
    {
        <div class="alert alert-warning">
            <strong>Some rows were skipped:</strong>
            <ul class="mb-0">
                @foreach (var err in Model.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <form asp-action="Import"
                  method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Upload .xlsx file</label>
                    <input type="file"
                           name="file"
                           class="form-control"
                           accept=".xlsx"
                           required />
                    <div class="form-text">
                        Use the template or any Excel file with the same column order.
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        Start Import
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.TotalRows > 0)
    {
        <div class="card">
            <div class="card-header">
                Import summary
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>File:</strong> @Model.FileName</p>
                <p class="mb-1"><strong>Total rows read:</strong> @Model.TotalRows</p>
                <p class="mb-1"><strong>Inserted:</strong> @Model.Inserted</p>
                <p class="mb-1"><strong>Skipped:</strong> @Model.Skipped</p>
            </div>
        </div>
    }
</div>
