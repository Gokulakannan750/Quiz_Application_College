@model Quiz_Application_College.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml"; // adjust if your admin layout path is different
}

<div class="container py-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <!-- Tiles: DO NOT mix href with asp-* tag helpers. Use ONLY href here. -->
    <div class="row g-3 mb-4">
        <!-- MCQ Dashboard -->
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/MCQ">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-2">MCQ Dashboard</h5>
                        <p class="card-text text-muted">Manage MCQ quizzes, schedules, enrolments & questions.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Coding Dashboard -->
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/Coding">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-2">Coding Dashboard</h5>
                        <p class="card-text text-muted">Manage coding quizzes, problems, schedules & enrolments.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Reports -->
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/Reports/Index">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-2">Reports</h5>
                        <p class="card-text text-muted">Exports & analytics.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Students DB tile -->
        <div class="col-md-4">
            <a class="text-decoration-none" href="/Admin/Students">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <h5 class="mb-1">Students DB</h5>
                        <div class="text-muted">Import students and (later) view/search them</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- More (placeholder) -->
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="#">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <a href="/Admin/Users/Index" class="card text-decoration-none">
                            <div class="card-body">
                                <h5 class="card-title">User & role management</h5>
                                <p class="card-text text-muted">Create admin/staff accounts and assign roles.</p>
                            </div>
                        </a>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Stats (read from @Model; never query Db in a view) -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Today & Totals</h5>
                    <div class="row text-center">
                        <div class="col-6 col-md-3">
                            <div class="h2">@Model?.TotalQuizzes ?? 0</div>
                            <div class="text-muted">Total Quizzes</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="h2">@Model?.OpenSchedulesNow ?? 0</div>
                            <div class="text-muted">Open Schedules Now</div>
                        </div>
                        <div class="col-6 col-md-3 mt-3 mt-md-0">
                            <div class="h2">@Model?.TotalEnrollments ?? 0</div>
                            <div class="text-muted">Total Enrolments</div>
                        </div>
                        <div class="col-6 col-md-3 mt-3 mt-md-0">
                            <div class="h2">@Model?.AttemptsToday ?? 0</div>
                            <div class="text-muted">Attempts Today</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

   </div>
