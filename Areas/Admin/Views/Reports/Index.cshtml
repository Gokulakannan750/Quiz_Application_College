@using Quiz_Application_College.Areas.Admin.Controllers
@model ReportsController.ReportsIndexVm

@{
    ViewData["Title"] = "Student Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Student Reports</h2>

    <!-- Filters -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4 col-lg-3">
                    <label class="form-label">College</label>
                    <select asp-for="SelectedCollege"
                            asp-items="Model.CollegeOptions"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label class="form-label">Department</label>
                    <select asp-for="SelectedDepartment"
                            asp-items="Model.DepartmentOptions"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label class="form-label">Search (name / register / email)</label>
                    <input asp-for="Search" class="form-control" />
                </div>

                <div class="col-md-4 col-lg-3">
                    <div class="form-check mt-4">
                        <input asp-for="OnlySuspicious" class="form-check-input" />
                        <label asp-for="OnlySuspicious" class="form-check-label">
                            Show only suspicious attempts
                        </label>
                    </div>
                </div>

                <div class="col-md-12 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        Apply filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        Clear
                    </a>
                </div>
            </form>

            <div class="mt-3 d-flex flex-wrap align-items-center gap-3">
                <a asp-action="Download"
                   asp-route-selectedCollege="@Model.SelectedCollege"
                   asp-route-selectedDepartment="@Model.SelectedDepartment"
                   asp-route-search="@Model.Search"
                   asp-route-onlySuspicious="@Model.OnlySuspicious"
                   class="btn btn-sm btn-success">
                    Download Excel
                </a>

                <div class="small text-muted">
                    <span class="badge bg-warning text-dark me-1">IP changed</span>
                    Different IP at start vs submit.
                    <span class="ms-3 badge bg-secondary me-1">Device changed</span>
                    Different browser / device info.
                </div>
            </div>
        </div>
    </div>

    <!-- MCQ results -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="card-title mb-3">MCQ quiz attempts</h4>

            @if (!Model.McqRows.Any())
            {
                <div class="alert alert-info mb-0">
                    No MCQ attempts found for the selected filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 18%;">Student</th>
                                <th style="width: 12%;">Register No</th>
                                <th style="width: 15%;">College</th>
                                <th style="width: 13%;">Department</th>
                                <th style="width: 20%;">Quiz</th>
                                <th style="width: 14%;">Flags</th>
                                <th style="width: 8%;" class="text-end">Marks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.McqRows)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="StudentAttempts"
                                           asp-route-id="@row.StudentProfileId">
                                            @row.StudentName
                                        </a>
                                    </td>
                                    <td>@row.RegisterNumber</td>
                                    <td>@row.College</td>
                                    <td>@row.Department</td>
                                    <td>@row.QuizTitle</td>
                                    <td>
                                        @if (row.IpChanged)
                                        {
                                            <span class="badge bg-warning text-dark me-1">IP changed</span>
                                        }
                                        @if (row.UserAgentChanged)
                                        {
                                            <span class="badge bg-secondary">Device changed</span>
                                        }
                                        @if (!row.IpChanged && !row.UserAgentChanged)
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </td>
                                    <td class="text-end">@row.TotalMarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Coding results -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="card-title mb-3">Coding quiz attempts</h4>

            @if (!Model.CodingRows.Any())
            {
                <div class="alert alert-info mb-0">
                    No Coding attempts found for the selected filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 18%;">Student</th>
                                <th style="width: 12%;">Register No</th>
                                <th style="width: 15%;">College</th>
                                <th style="width: 13%;">Department</th>
                                <th style="width: 20%;">Quiz</th>
                                <th style="width: 14%;">Flags</th>
                                <th style="width: 8%;" class="text-end">Marks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.CodingRows)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="StudentAttempts"
                                           asp-route-id="@row.StudentProfileId">
                                            @row.StudentName
                                        </a>
                                    </td>
                                    <td>@row.RegisterNumber</td>
                                    <td>@row.College</td>
                                    <td>@row.Department</td>
                                    <td>@row.QuizTitle</td>
                                    <td>
                                        @if (row.IpChanged)
                                        {
                                            <span class="badge bg-warning text-dark me-1">IP changed</span>
                                        }
                                        @if (row.UserAgentChanged)
                                        {
                                            <span class="badge bg-secondary">Device changed</span>
                                        }
                                        @if (!row.IpChanged && !row.UserAgentChanged)
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </td>
                                    <td class="text-end">@row.TotalMarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
