@using Quiz_Application_College.Areas.Admin.Controllers
@model ReportsController.StudentAttemptDetailVm

@{
    ViewData["Title"] = "Student attempts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <a asp-action="Index" class="btn btn-link mb-3">
        &laquo; Back to Student Reports
    </a>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="card-title">@Model.StudentName (@Model.RegisterNumber)</h4>
            <p class="mb-0 text-muted">
                <strong>College:</strong> @Model.College
                <span class="mx-3">|</span>
                <strong>Department:</strong> @Model.Department
            </p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">All quiz attempts</h5>

            @if (!Model.Attempts.Any())
            {
                <div class="alert alert-info mb-0">
                    No attempts found for this student.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Quiz</th>
                                <th>Type</th>
                                <th class="text-end">Score</th>
                                <th>Started at</th>
                                <th>Submitted at</th>
                                <th>Start IP</th>
                                <th>Submit IP</th>
                                <th>Flags</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Attempts)
                            {
                                <tr>
                                    <td>@a.QuizTitle</td>
                                    <td>@a.QuizType</td>
                                    <td class="text-end">@a.Score</td>
                                    <td>@a.StartedAt</td>
                                    <td>@(a.SubmittedAt.HasValue? a.SubmittedAt.Value.ToString() : "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(a.StartIpAddress) ? "-" : a.StartIpAddress)</td>
                                    <td>@(string.IsNullOrWhiteSpace(a.SubmitIpAddress) ? "-" : a.SubmitIpAddress)</td>
                                    <td>
                                        @if (a.IpChanged)
                                        {
                                            <span class="badge bg-warning text-dark me-1">IP changed</span>
                                        }
                                        @if (a.UserAgentChanged)
                                        {
                                            <span class="badge bg-secondary">Device changed</span>
                                        }
                                        @if (!a.IpChanged && !a.UserAgentChanged)
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
