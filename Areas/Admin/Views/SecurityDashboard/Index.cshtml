@using Quiz_Application_College.Areas.Admin.Controllers
@model SecurityDashboardController.SecurityDashboardVm

@{
    ViewData["Title"] = "Security Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Security Dashboard</h2>

    @if (Model.TotalAttempts == 0)
    {
        <div class="alert alert-info">
            No attempts found yet. Security metrics will appear once students start writing quizzes.
        </div>
    }
    else
    {
        <!-- Top summary cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Total attempts</div>
                        <div class="fs-4 fw-bold">@Model.TotalAttempts</div>
                        <div class="small mt-1">
                            MCQ: @Model.TotalMcqAttempts |
                            Coding: @Model.TotalCodingAttempts
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Suspicious attempts</div>
                        <div class="fs-4 fw-bold text-danger">@Model.TotalSuspiciousAttempts</div>
                        <div class="small mt-1">
                            MCQ: @Model.SuspiciousMcqAttempts |
                            Coding: @Model.SuspiciousCodingAttempts
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Students attempted</div>
                        <div class="fs-4 fw-bold">@Model.TotalStudentsAttempted</div>
                        <div class="small mt-1 text-muted">
                            Total unique student profiles.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Students with suspicious attempts</div>
                        <div class="fs-4 fw-bold text-warning">@Model.TotalStudentsWithSuspicious</div>
                        <div class="small mt-1 text-muted">
                            Based on IP / device changes.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Per-quiz summary table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Per-quiz security summary</h5>

                @if (!Model.QuizSummaries.Any())
                {
                    <div class="alert alert-info mb-0">
                        No quiz attempts found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Quiz</th>
                                    <th>Type</th>
                                    <th class="text-end">Total attempts</th>
                                    <th class="text-end">Suspicious attempts</th>
                                    <th class="text-end">Suspicious %</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model.QuizSummaries)
                                {
                                    var badgeClass = q.SuspiciousPercent >= 20 ? "bg-danger" :
                                    q.SuspiciousPercent >= 5 ? "bg-warning text-dark" :
                                    "bg-success";

                                    <tr>
                                        <td>@q.Title</td>
                                        <td>@q.Type</td>
                                        <td class="text-end">@q.TotalAttempts</td>
                                        <td class="text-end">@q.SuspiciousAttempts</td>
                                        <td class="text-end">
                                            <span class="badge @badgeClass">
                                                @q.SuspiciousPercent.ToString("0.0")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="small text-muted mt-3">
                        Suspicious = IP changed and/or device (browser user agent) changed between quiz start and submit.
                    </p>
                }
            </div>
        </div>
    }
</div>
