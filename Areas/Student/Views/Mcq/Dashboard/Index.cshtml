@using Quiz_Application_College.Areas.Student.Controllers.Mcq
@model IEnumerable<Quiz_Application_College.Areas.Student.Controllers.Mcq.DashboardController.McqAvailableVm>

@{
    ViewData["Title"] = "MCQ Quizzes";
    var now = DateTimeOffset.UtcNow;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">MCQ Quizzes</h2>
    <p class="text-muted mb-4">
        Here are the MCQ quizzes that are available for you based on your enrollments.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have no MCQ quizzes available right now.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var quiz in Model)
            {
                var isLive = now >= quiz.StartAt && now <= quiz.EndAt;
                var isUpcoming = now < quiz.StartAt;
                var isClosed = now > quiz.EndAt;

                string statusText;
                string badgeClass;

                if (isLive)
                {
                    statusText = "Live";
                    badgeClass = "bg-success";
                }
                else if (isUpcoming)
                {
                    statusText = "Upcoming";
                    badgeClass = "bg-info text-dark";
                }
                else
                {
                    statusText = "Closed";
                    badgeClass = "bg-secondary";
                }

                var attemptsLeft = quiz.MaxAttempts - quiz.UsedAttempts;
                if (attemptsLeft < 0) attemptsLeft = 0;

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="card-title mb-1">@quiz.Title</h5>
                                    <p class="text-muted small mb-0">
                                        Duration: @quiz.DurationMinutes min
                                    </p>
                                </div>
                                <span class="badge @badgeClass">
                                    @statusText
                                </span>
                            </div>

                            <div class="small mb-2">
                                <div>
                                    <strong>Window:</strong>
                                    @quiz.StartAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")
                                    –
                                    @quiz.EndAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")
                                </div>
                            </div>

                            <div class="mb-3 small">
                                <strong>Attempts:</strong>
                                @quiz.UsedAttempts / @quiz.MaxAttempts
                                @if (attemptsLeft > 0)
                                {
                                    <span class="text-success ms-1">( @attemptsLeft left )</span>
                                }
                                else
                                {
                                    <span class="text-danger ms-1">( no attempts left )</span>
                                }
                            </div>

                            <div class="mt-auto">
                                @if (isLive && quiz.CanStart && attemptsLeft > 0)
                                {
                                    <a href="@Url.Content($"/Student/MCQ/Exam/Play?quizId={quiz.QuizId}")"
                                       class="btn btn-primary w-100">
                                        Start quiz
                                    </a>
                                }

                                else if (!isLive)
                                {
                                    <button class="btn btn-outline-secondary w-100" disabled>
                                        @statusText
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary w-100" disabled>
                                        Attempts exhausted
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
