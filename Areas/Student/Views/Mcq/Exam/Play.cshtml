@model Quiz_Application_College.Areas.Student.Controllers.Mcq.ExamController.McqExamVm

@{
    ViewData["Title"] = Model.QuizTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">@Model.QuizTitle</h2>
                <span class="badge bg-info-subtle text-info-emphasis">
                    Duration: @Model.DurationMinutes min
                </span>
            </div>

            <p class="text-muted">
                Please answer all questions within the time limit.
            </p>

            <form method="post"
                  asp-area="Student"
                  asp-controller="Exam"
                  asp-action="Play"
                  id="examForm">

                @Html.AntiForgeryToken()

                <!-- Hidden state -->
                <input type="hidden" asp-for="QuizId" />
                <input type="hidden" name="quizId" value="@Model.QuizId" />

                <!-- TIMER BAR (top) -->
                <div id="timer-container"
                     class="alert d-flex justify-content-between align-items-center mb-3">
                    <strong>Time remaining:</strong>
                    <span id="timer-text">--:--</span>
                </div>

                <div class="card">
                    <div class="card-body">

                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <div class="alert alert-warning mb-0">
                                No questions found for this quiz.
                            </div>
                        }
                        else
                        {
                            <!-- QUESTION PALETTE -->
                            <div class="mb-3">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-semibold me-2">Questions:</span>

                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary question-pill"
                                                data-qindex="@i">
                                            @item.Index
                                        </button>
                                    }
                                </div>
                                <div class="small text-muted mt-1">
                                    <span class="badge bg-primary me-1">&nbsp;</span> Current
                                    <span class="badge bg-success ms-2 me-1">&nbsp;</span> Answered
                                    <span class="badge bg-light border text-muted ms-2 me-1">&nbsp;</span> Not answered
                                </div>
                            </div>

                            <!-- QUESTIONS (one visible at a time) -->
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];

                                <div class="question-block mb-4 pb-3 border-bottom" data-qindex="@i">
                                    <input type="hidden" name="Items[@i].QuestionId" value="@item.QuestionId" />
                                    <input type="hidden" name="Items[@i].Index" value="@item.Index" />

                                    <h5>
                                        Question @item.Index of @Model.Items.Count
                                    </h5>

                                    <p class="mb-2">@item.Text</p>

                                    <div class="ms-2">
                                        @for (int j = 0; j < item.Options.Count; j++)
                                        {
                                            var opt = item.Options[j];
                                            var radioId = $"q{item.Index}_opt{j}";

                                            <div class="form-check mb-1">
                                                <input class="form-check-input"
                                                       id="@radioId"
                                                       name="Items[@i].SelectedOptionId"
                                                       type="radio"
                                                       value="@opt.OptionId"
                                                       @(item.SelectedOptionId == opt.OptionId ? "checked" : "") />


                                                <label class="form-check-label" for="@radioId">
                                                    @opt.Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- NAVIGATION + SUBMIT BUTTONS -->
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="btn-group" role="group" aria-label="Question navigation">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            id="btnPrev">
                                        Previous
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            id="btnNext">
                                        Next
                                    </button>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Submit quiz
                                </button>
                            </div>
                        }

                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // =============================
        // TIMER (server-driven)
        // =============================
        (function () {
            var form = document.getElementById('examForm');
            var timerText = document.getElementById('timer-text');
            var timerContainer = document.getElementById('timer-container');

            // Start from RemainingSeconds sent by the server
            var totalSeconds = @Model.RemainingSeconds;
            if (!totalSeconds || totalSeconds < 0) {
                totalSeconds = 0;
            }

            var originalTotalSeconds = totalSeconds;

            function formatTime(seconds) {
                var m = Math.floor(seconds / 60);
                var s = seconds % 60;
                var mm = m.toString().padStart(2, '0');
                var ss = s.toString().padStart(2, '0');
                return mm + ":" + ss;
            }

            function updateTimerStyle() {
                if (!timerContainer || originalTotalSeconds <= 0) return;

                var ratio = totalSeconds / originalTotalSeconds;

                timerContainer.classList.remove('alert-success', 'alert-warning', 'alert-danger');
                timerContainer.classList.add('alert');

                if (totalSeconds <= 0 || ratio <= 0.2) {
                    // last 20% -> red
                    timerContainer.classList.add('alert-danger');
                } else if (ratio <= 0.5) {
                    // 20%–50% -> orange
                    timerContainer.classList.add('alert-warning');
                } else {
                    // >50% -> green
                    timerContainer.classList.add('alert-success');
                }
            }

            if (timerText) {
                timerText.textContent = formatTime(totalSeconds);
            }
            updateTimerStyle();

            var intervalId = setInterval(function () {
                totalSeconds--;

                if (totalSeconds <= 0) {
                    clearInterval(intervalId);
                    totalSeconds = 0;

                    if (timerText) {
                        timerText.textContent = "00:00";
                    }
                    updateTimerStyle();

                    if (form) {
                        form.submit();
                    }
                } else {
                    if (timerText) {
                        timerText.textContent = formatTime(totalSeconds);
                    }
                    updateTimerStyle();
                }
            }, 1000);
        })();


        // =============================
        // QUESTION NAVIGATION + PALETTE
        // =============================
        (function () {
            var questionBlocks = document.querySelectorAll('.question-block');
            var questionPills = document.querySelectorAll('.question-pill');
            var btnPrev = document.getElementById('btnPrev');
            var btnNext = document.getElementById('btnNext');
            var currentIndex = 0;

            if (!questionBlocks.length) return;

            function isAnswered(index) {
                var block = questionBlocks[index];
                if (!block) return false;
                return !!block.querySelector('input[type="radio"]:checked');
            }

            function updatePillStyles() {
                if (!questionPills.length) return;

                questionPills.forEach(function (pill, i) {
                    pill.classList.remove('btn-primary', 'btn-success', 'btn-outline-secondary', 'text-white');

                    if (i === currentIndex) {
                        pill.classList.add('btn-primary', 'text-white'); // current
                    } else if (isAnswered(i)) {
                        pill.classList.add('btn-success', 'text-white'); // answered
                    } else {
                        pill.classList.add('btn-outline-secondary'); // not answered
                    }
                });
            }

            function showQuestion(index) {
                if (index < 0 || index >= questionBlocks.length) return;
                currentIndex = index;

                questionBlocks.forEach(function (block, i) {
                    block.style.display = (i === index) ? '' : 'none';
                });

                updatePillStyles();
            }

            // Pill click → jump to that question
            questionPills.forEach(function (pill, i) {
                pill.addEventListener('click', function () {
                    showQuestion(i);
                });
            });

            // Prev / Next buttons
            if (btnPrev) {
                btnPrev.addEventListener('click', function () {
                    var prev = currentIndex - 1;
                    if (prev < 0) prev = 0;
                    showQuestion(prev);
                });
            }

            if (btnNext) {
                btnNext.addEventListener('click', function () {
                    var next = currentIndex + 1;
                    if (next >= questionBlocks.length) next = questionBlocks.length - 1;
                    showQuestion(next);
                });
            }

            // When user answers (changes radio), recalc palette
            var allRadios = document.querySelectorAll('.question-block input[type="radio"]');
            allRadios.forEach(function (radio) {
                radio.addEventListener('change', function () {
                    updatePillStyles();
                });
            });

            // Initial state: show first question only
            showQuestion(0);
        })();
    </script>
}

