@model Quiz_Application_College.Areas.Student.Controllers.Coding.ExamController.CodingExamVm

@{
    ViewData["Title"] = Model.QuizTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-9 mx-auto">

            <h2 class="mb-0">@Model.QuizTitle</h2>
            <p class="text-muted">Duration: @Model.DurationMinutes min</p>

            <!-- TIMER -->
            <div id="timerBar" class="alert alert-success d-flex justify-content-between align-items-center">
                <span>Time remaining:</span>
                <span id="timerText"></span>
            </div>

            <form id="examForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="QuizId" />

                <!-- PROBLEM -->
                <div class="card mb-3">
                    <div class="card-header fw-bold">Problem</div>
                    <div class="card-body">
                        <h5 class="mb-2">@Model.ProblemTitle</h5>
                        <pre class="mb-0" style="white-space:pre-wrap;">@Model.Questions</pre>
                    </div>
                </div>

                <!-- PUBLIC TESTCASES -->
                <div class="card mb-3">
                    <div class="card-header fw-bold">Public testcases</div>
                    <div class="card-body">
                        @if (Model.SampleCases != null && Model.SampleCases.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:40%;">Input</th>
                                            <th style="width:60%;">Expected output</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in Model.SampleCases)
                                        {
                                            <tr>
                                                <td><pre class="mb-0" style="white-space:pre-wrap;">@t.Input</pre></td>
                                                <td><pre class="mb-0" style="white-space:pre-wrap;">@t.ExpectedOutput</pre></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No public testcases provided.</p>
                        }
                    </div>
                </div>

                <!-- EDITOR -->
                <div class="card mb-3">
                    <div class="card-header fw-bold">Editor</div>
                    <div class="card-body">

                        <div class="mb-3">
                            <label for="Language">Language</label>
                            <select id="Language" name="Language" class="form-control">
                                <option value="python">Python</option>
                                <option value="csharp">C#</option>
                                <option value="cpp">C++</option>
                                <option value="java">Java</option>
                                <option value="js">JavaScript</option>
                            </select>

                        </div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label">Your code</label>

                            <!-- Textarea is the POST source; Monaco syncs into this -->
                            <textarea id="codeArea"
                                      asp-for="Code"
                                      class="form-control"
                                      rows="14"
                                      spellcheck="false"
                                      style="font-family:Consolas,'Courier New',monospace;white-space:pre;"></textarea>

                            <div class="form-text">
                                Hidden testcases are NOT shown here; they will be used during grading.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RUN + SUBMIT -->
                <div class="d-flex justify-content-between mb-3">
                    <button type="button" id="btnRun" class="btn btn-secondary" onclick="runCode()">
                        Run code
                    </button>

                    <button type="button" id="btnSubmit" class="btn btn-primary" onclick="confirmAndSubmit()">
                        Submit code
                    </button>
                </div>

                <!-- RUN RESULTS PANEL -->
                <div class="card mb-4" id="runPanel" style="display:none;">
                    <div class="card-header fw-bold">Run results</div>
                    <div class="card-body">
                        <div id="runStatus" class="mb-2 text-muted">
                            Click "Run code" to test your solution against public testcases.
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:7%;">#</th>
                                        <th style="width:23%;">Input</th>
                                        <th style="width:23%;">Expected output</th>
                                        <th style="width:23%;">Actual output</th>
                                        <th style="width:24%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="runBody">
                                    <tr>
                                        <td colspan="5" class="text-muted">No runs yet.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <!-- TIMER SCRIPT using RemainingSeconds from server (no reset on refresh) -->
    <script>
        (function () {
            var total = @Model.RemainingSeconds;
            if (!total || total < 0) total = 0;

            var originalTotal = total;
            var text = document.getElementById("timerText");
            var bar = document.getElementById("timerBar");
            var form = document.getElementById("examForm");

            function render() {
                var m = Math.floor(total / 60);
                var s = total % 60;
                var mm = m.toString().padStart(2, '0');
                var ss = s.toString().padStart(2, '0');
                if (text) text.textContent = mm + ":" + ss;

                if (!bar || originalTotal <= 0) return;

                var ratio = total / originalTotal;
                bar.classList.remove("alert-success", "alert-warning", "alert-danger");

                if (ratio <= 0.2) {
                    bar.classList.add("alert-danger");   // red
                } else if (ratio <= 0.5) {
                    bar.classList.add("alert-warning");  // orange
                } else {
                    bar.classList.add("alert-success");  // green
                }
            }

            render();

            var timerId = setInterval(function () {
                total--;

                if (total <= 0) {
                    total = 0;
                    clearInterval(timerId);
                    render();
                    if (form) form.submit();   // auto-submit when time is over
                } else {
                    render();
                }
            }, 1000);
        })();
    </script>

    <!-- MONACO EDITOR LOADING -->
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.min.js"></script>
    <script>
        (function () {
            const ta = document.getElementById('codeArea');
            if (!ta) return;
            if (!window.require) return;

            window.require.config({
                paths: { 'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' }
            });

            window.require(['vs/editor/editor.main'], function () {
                const wrapper = document.createElement('div');
                wrapper.style.height = '420px';
                wrapper.className = 'border rounded';
                ta.parentNode.insertBefore(wrapper, ta);
                ta.style.display = 'none';

                const langSel = document.querySelector('[name="Language"]');

                const editor = monaco.editor.create(wrapper, {
                    value: ta.value || '',
                    language: (langSel && langSel.value) || 'cpp',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });

                // keep textarea in sync for form POST
                editor.onDidChangeModelContent(function () {
                    ta.value = editor.getValue();
                });

                // change language on dropdown
                if (langSel) {
                    langSel.addEventListener('change', function () {
                        monaco.editor.setModelLanguage(editor.getModel(), langSel.value || 'cpp');
                    });
                }
            });
        })();
    </script>

    <script>
        function runCode() {
            const runBtn = document.getElementById('btnRun');
            const runPanel = document.getElementById('runPanel');
            const runStatus = document.getElementById('runStatus');
            const runBody = document.getElementById('runBody');
            const codeArea = document.getElementById('codeArea');
            const langSelect = document.querySelector('[name="Language"]');

            if (!runBtn) {
                console.error('Run button not found');
                return;
            }

            const runUrl = '@Url.Action("Run", "Exam", new { area = "Student", quizId = Model.QuizId })';
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const code = codeArea ? (codeArea.value || '') : '';
            // IMPORTANT: this will now be "python", "cpp", "csharp", etc.
            const language = langSelect ? (langSelect.value || 'cpp') : 'cpp';

            runBtn.disabled = true;
            if (runPanel) runPanel.style.display = '';
            if (runStatus) runStatus.textContent = 'Running code on public testcases...';
            if (runBody) runBody.innerHTML = '';

            const body = new URLSearchParams();
            body.append('__RequestVerificationToken', token);
            body.append('code', code);
            body.append('language', language);

            return fetch(runUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                },
                body: body.toString()
            })
            .then(function (resp) {
                if (!resp.ok) {
                    throw new Error('HTTP ' + resp.status);
                }
                return resp.json();
            })
            .then(function (res) {
                runBtn.disabled = false;

                if (!res || res.success === false) {
                    if (runStatus) {
                        runStatus.textContent = (res && res.message) ? res.message : 'Run failed.';
                    }
                    if (!res || !res.cases || !res.cases.length) {
                        if (runBody && !runBody.innerHTML) {
                            runBody.innerHTML = '<tr><td colspan="5" class="text-muted">No testcases.</td></tr>';
                        }
                    }
                    return;
                }

                if (runStatus) {
                    runStatus.textContent = res.message || 'Run completed.';
                }

                if (!res.cases || !res.cases.length) {
                    if (runBody) {
                        runBody.innerHTML = '<tr><td colspan="5" class="text-muted">No testcases returned.</td></tr>';
                    }
                    return;
                }

                res.cases.forEach(function (c, index) {
                    const tr = document.createElement('tr');
                    const badge = c.passed
                        ? '<span class="badge bg-success">Passed</span>'
                        : '<span class="badge bg-danger">Failed</span>';

                    const isHidden = !!c.isHidden;
                    const inputText = isHidden ? 'Hidden testcase' : (c.input || '');
                    const expectedText = isHidden ? 'Hidden' : (c.expected || '');
                    const actualText = isHidden ? 'Hidden' : (c.actual || '');

                    tr.innerHTML =
                        '<td>' + (index + 1) + '</td>' +
                        '<td><pre class="mb-0">' + inputText + '</pre></td>' +
                        '<td><pre class="mb-0">' + expectedText + '</pre></td>' +
                        '<td><pre class="mb-0">' + actualText + '</pre></td>' +
                        '<td>' + badge + (isHidden ? ' <span class="text-muted small">(hidden)</span>' : '') + '</td>';

                    if (runBody) {
                        runBody.appendChild(tr);
                    }
                });
            })
            .catch(function (err) {
                console.error(err);
                runBtn.disabled = false;
                if (runStatus) runStatus.textContent = 'Error calling Run API.';
                if (runBody && !runBody.innerHTML) {
                    runBody.innerHTML = '<tr><td colspan="5" class="text-muted">Error.</td></tr>';
                }
            });
        }

        function confirmAndSubmit() {
            var form = document.getElementById('examForm');
            if (!form) return;

            var ok = window.confirm("Are you sure you want to submit your code? Your code will be run once before submission.");
            if (!ok) return;

            var p = runCode();
            if (p && typeof p.then === 'function') {
                p.then(function () {
                    form.submit();
                }).catch(function () {
                    // Even if Run fails (network or API error), still submit the attempt
                    form.submit();
                });
            } else {
                form.submit();
            }
        }
    </script>

    <!-- ANTI-CHEATING MEASURES -->
    <script>
        (function () {
            const quizId = '@Model.QuizId';    // adjust property name if needed
            const examForm = document.getElementById('examForm');

            // -------------------------------------------------
            // 1. Tab switch detection: warn, then auto-submit
            // -------------------------------------------------
            let hiddenCount = 0;
            const MAX_WARN = 1;
            const AUTO_SUBMIT_COUNT = 2;

            document.addEventListener('visibilitychange', function () {
                if (document.hidden) {
                    hiddenCount++;

                    if (hiddenCount <= MAX_WARN) {
                        alert(
                            'Warning: you left the coding exam tab.\n' +
                            (MAX_WARN - hiddenCount + 1) +
                            ' more time(s) and the exam will be auto-submitted.'
                        );
                    } else if (hiddenCount === AUTO_SUBMIT_COUNT) {
                        alert(
                            'You left the coding exam tab multiple times.\n' +
                            'Your code will now be submitted.'
                        );
                        if (examForm) {
                            examForm.submit();
                        }
                    }
                }
            });

            // -------------------------------------------------
            // 2. Disable right-click / copy / cut / paste
            //    in the coding editor
            // -------------------------------------------------
            const editor = document.getElementById('codeEditor');

            if (editor) {
                ['contextmenu', 'copy', 'cut', 'paste'].forEach(function (evt) {
                    editor.addEventListener(evt, function (e) {
                        e.preventDefault();

                        if (evt === 'contextmenu') {
                            alert('Right-click is disabled during the coding exam.');
                        } else if (evt === 'paste') {
                            alert('Pasting is disabled during the coding exam.');
                        } else if (evt === 'copy') {
                            alert('Copying code is disabled during the coding exam.');
                        } else if (evt === 'cut') {
                            alert('Cut is disabled during the coding exam.');
                        }
                    });
                });
            }

            // -------------------------------------------------
            // 3. Single-tab lock using localStorage
            // -------------------------------------------------
            if (quizId) {
                const lockKey = 'quiz-lock-' + quizId;
                const tabKey = 'quiz-tab-' + quizId;
                const thisTabId =
                    Date.now().toString() + '_' +
                    Math.random().toString(36).substring(2);

                sessionStorage.setItem(tabKey, thisTabId);

                const existingOwner = localStorage.getItem(lockKey);
                if (existingOwner && existingOwner !== thisTabId) {
                    alert(
                        'This coding quiz is already open in another tab or window.\n' +
                        'Please continue in that tab.'
                    );
                    window.location.href = '/Student/Home/Index';
                    return;
                }

                localStorage.setItem(lockKey, thisTabId);

                window.addEventListener('storage', function (e) {
                    if (e.key === lockKey &&
                        e.newValue &&
                        e.newValue !== thisTabId) {
                        alert(
                            'This coding quiz has been opened in another tab.\n' +
                            'This attempt will be closed.'
                        );
                        window.location.href = '/Student/Home/Index';
                    }
                });

                window.addEventListener('beforeunload', function () {
                    const currentOwner = localStorage.getItem(lockKey);
                    if (currentOwner === thisTabId) {
                        localStorage.removeItem(lockKey);
                    }
                });
            }
        })();
    </script>
}
