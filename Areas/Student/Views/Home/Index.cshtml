@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5">
    <h1 class="mb-4">Welcome</h1>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Admin</h5>
                        <p class="text-muted mb-0">Manage quizzes, schedules, enrollments.</p>
                    </div>
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Admin Login</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Student</h5>
                        <p class="text-muted mb-0">Take MCQ and Coding quizzes.</p>
                    </div>
                    <a class="btn btn-success" asp-area="Student" asp-controller="Auth" asp-action="Login">Student Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
