@using Quiz_Application_College.Areas.Student.Controllers
@model HistoryController.HistoryIndexVm

@{
    ViewData["Title"] = "Quiz History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var mcqItems = Model.Items
        .Where(i => string.Equals(i.QuizType, "Mcq", System.StringComparison.OrdinalIgnoreCase)
                 || string.Equals(i.QuizType, "MCQ", System.StringComparison.OrdinalIgnoreCase))
        .ToList();

    var codingItems = Model.Items
        .Where(i => string.Equals(i.QuizType, "Coding", System.StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Quiz history</h2>

        <a asp-area="Student"
           asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to dashboard
        </a>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-info">
            You haven’t completed any quizzes yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <div class="me-3">
                    <span class="fw-semibold">Total attempts:</span>
                    <span class="badge bg-primary ms-1">@Model.Items.Count</span>
                </div>

                <div class="me-3">
                    <span class="fw-semibold">MCQ:</span>
                    <span class="badge bg-success ms-1">@mcqItems.Count</span>
                </div>

                <div class="me-3">
                    <span class="fw-semibold">Coding:</span>
                    <span class="badge bg-info text-dark ms-1">@codingItems.Count</span>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <label for="quizTypeFilter" class="form-label mb-0">
                        <strong>Show:</strong>
                    </label>
                    <select id="quizTypeFilter" class="form-select form-select-sm w-auto">
                        <option value="all" selected>All</option>
                        <option value="mcq">MCQ only</option>
                        <option value="coding">Coding only</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- MCQ table -->
        <div id="mcqTableWrapper" class="history-table mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">MCQ attempts</h5>
                    <span class="badge bg-success">@mcqItems.Count</span>
                </div>

                <div class="card-body p-0">
                    @if (!mcqItems.Any())
                    {
                        <div class="alert alert-secondary py-3 mb-0 rounded-0">
                            You don’t have any completed MCQ quiz attempts yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 32%;">Quiz</th>
                                        <th style="width: 17%;">Started</th>
                                        <th style="width: 17%;">Submitted</th>
                                        <th style="width: 10%;">Duration (min)</th>
                                        <th style="width: 12%;">Score</th>
                                        <th style="width: 12%;">Attempt ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in mcqItems)
                                    {
                                        <tr>
                                            <td>@a.QuizTitle</td>
                                            <td>@a.StartedAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                                            <td>
                                                @(a.SubmittedAt?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                            </td>
                                            <td>@a.DurationMinutes</td>
                                            <td>@a.Score</td>
                                            <td class="text-muted">
                                                @a.AttemptId.ToString().Substring(0, 8)...
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Coding table -->
        <div id="codingTableWrapper" class="history-table mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Coding attempts</h5>
                    <span class="badge bg-info text-dark">@codingItems.Count</span>
                </div>

                <div class="card-body p-0">
                    @if (!codingItems.Any())
                    {
                        <div class="alert alert-secondary py-3 mb-0 rounded-0">
                            You don’t have any completed Coding quiz attempts yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 32%;">Quiz</th>
                                        <th style="width: 17%;">Started</th>
                                        <th style="width: 17%;">Submitted</th>
                                        <th style="width: 10%;">Duration (min)</th>
                                        <th style="width: 12%;">Score</th>
                                        <th style="width: 12%;">Attempt ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in codingItems)
                                    {
                                        <tr class="table-light">
                                            <td>@a.QuizTitle</td>
                                            <td>@a.StartedAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                                            <td>
                                                @(a.SubmittedAt?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                            </td>
                                            <td>@a.DurationMinutes</td>
                                            <td>@a.Score</td>
                                            <td class="text-muted">
                                                @a.AttemptId.ToString().Substring(0, 8)...
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const filter = document.getElementById('quizTypeFilter');
            const mcqWrapper = document.getElementById('mcqTableWrapper');
            const codingWrapper = document.getElementById('codingTableWrapper');

            if (!filter || !mcqWrapper || !codingWrapper) {
                return;
            }

            function applyFilter() {
                const value = filter.value;
                if (value === 'all') {
                    mcqWrapper.style.display = '';
                    codingWrapper.style.display = '';
                } else if (value === 'mcq') {
                    mcqWrapper.style.display = '';
                    codingWrapper.style.display = 'none';
                } else if (value === 'coding') {
                    mcqWrapper.style.display = 'none';
                    codingWrapper.style.display = '';
                }
            }

            filter.addEventListener('change', applyFilter);
            applyFilter(); // initial state
        })();
    </script>
}
