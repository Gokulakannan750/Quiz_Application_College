@{
    ViewData["Title"] = "Student Dashboard";
    int enrolled = ViewBag.EnrolledCount ?? 0;
    int openNow = ViewBag.OpenNowCount ?? 0;
    int attempts = ViewBag.AttemptsCount ?? 0;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 mb-1">Student Dashboard</h1>
        <div class="text-muted">Welcome back! Ready to test your skills?</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-primary" asp-area="Student" asp-controller="Dashboard" asp-action="Index">Go to My Quizzes</a>
        <a class="btn btn-sm btn-outline-primary" asp-area="Student" asp-controller="Results" asp-action="Index">My Results</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="dash-card position-relative">
            <div class="dash-label">Enrolled Quizzes</div>
            <div class="dash-value">@enrolled</div>
            <a class="stretched-link" asp-area="Student" asp-controller="Dashboard" asp-action="Index"></a>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="dash-card position-relative">
            <div class="dash-label">Open Now</div>
            <div class="dash-value">@openNow</div>
            <a class="stretched-link" asp-area="Student" asp-controller="Dashboard" asp-action="Index"></a>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="dash-card position-relative">
            <div class="dash-label">Total Attempts</div>
            <div class="dash-value">@attempts</div>
            <a class="stretched-link" asp-area="Student" asp-controller="Results" asp-action="Index"></a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-2">Quick Actions</h5>
        <a class="btn btn-primary me-2" asp-area="Student" asp-controller="Dashboard" asp-action="Index">Browse Available Quizzes</a>
        <a class="btn btn-outline-primary" asp-area="Student" asp-controller="Results" asp-action="Index">View My Results</a>
    </div>
</div>
