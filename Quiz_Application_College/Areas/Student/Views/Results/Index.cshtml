@model IEnumerable<Quiz_Application_College.Areas.Student.Controllers.ResultsController.ResultRow>
@{
    ViewData["Title"] = "My Results";
}
<h2>My Results</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No attempts yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Quiz</th>
                <th>Started</th>
                <th>Submitted</th>
                <th class="text-end">Score</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.QuizTitle</td>
                    <td>@r.StartedAt.LocalDateTime</td>
                    <td>@(r.SubmittedAt.HasValue? r.SubmittedAt.Value.LocalDateTime.ToString() : "-")</td>
                    <td class="text-end">@r.Score</td>
                </tr>
            }
        </tbody>
    </table>
}
