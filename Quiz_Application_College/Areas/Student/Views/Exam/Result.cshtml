@model Quiz_Application_College.Domain.Attempt
@{
    ViewData["Title"] = "Result";
}
<h2>@Model.Quiz?.Title — Result</h2>

<div class="alert alert-success">
    <strong>Score:</strong> @Model.Score
</div>

<a class="btn btn-secondary" asp-area="Student" asp-controller="Dashboard" asp-action="Index">
    Back to My Quizzes
</a>
@if (Model.Quiz?.ShowReviewOnSubmit == true)
{
    <a class="btn btn-primary" asp-action="Review" asp-route-attemptId="@Model.Id">View Review</a>
}

