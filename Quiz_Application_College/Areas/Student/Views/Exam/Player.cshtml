@using System
@using System.Linq
@using System.Collections.Generic
@model Quiz_Application_College.ViewModels.ExamPlayerVm

@{
    ViewData["Title"] = "Exam Player";

    Guid attemptId = Model?.AttemptId != Guid.Empty
        ? Model.AttemptId
        : (Guid)(ViewBag.AttemptId ?? Guid.Empty);

    // Coding questions (filled in ExamController.Player)
    var codingQuestions = ViewBag.CodingQuestions as IEnumerable<dynamic>;
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@Model?.QuizTitle</h2>
        <div class="text-muted">
            Duration: @Model?.DurationMinutes min
        </div>
    </div>

    @* ---------- MCQ SECTION (keep your existing MCQ UI here) ---------- *@
    @if (Model?.Questions != null && Model.Questions.Any())
    {
        var idx = 1;
        foreach (var q in Model.Questions)
        {
            <div class="mb-3">
                <div class="small text-muted">Question @idx</div>
                <div class="card">
                    <div class="card-body">
                        <strong>@q.Text</strong>

                        @* TODO: Replace this list with your actual MCQ option inputs *@
                        <ul class="mt-2">
                            @foreach (var opt in q.Options)
                            {
                                <li>@opt.Text</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            idx++;
        }
    }
    else
    {
        <div class="alert alert-info">No MCQ questions loaded.</div>
    }

    @* ---------- CODING SECTION (NEW) ---------- *@
    @if (codingQuestions != null && codingQuestions.Any())
    {
        <hr class="my-4" />
        <h4 class="mb-3">Coding Questions</h4>

        @foreach (var cq in codingQuestions)
        {
            string langsCsv = (string)(cq?.AllowedLanguagesCsv ?? "python");
            var langs = langsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            string defaultLang = langs.FirstOrDefault() ?? "python";

            @await Html.PartialAsync("~/Areas/Student/Views/Partials/_CodingEditor.cshtml", new {
            Id = (Guid)(cq?.Id ?? Guid.Empty),
        Title = (string)(cq?.Title ?? "Coding Question"),
        Prompt = (string)(cq?.Prompt ?? ""),
        PromptHtml = (string)null, // set if you store HTML
        AllowedLanguages = langs,
        DefaultLanguage = defaultLang,
        StarterCodeJson = (string)(cq?.StarterCodeJson ?? ""),
        AttemptId = attemptId
        })
        }
        }
        else
    {
        <div class="alert alert-warning mt-3">No coding questions linked to this quiz.</div>
    }

    @* ---------- SUBMIT AREA (keep your submit form here) ---------- *@
    <div class="mt-4">
        @* EXAMPLE ONLY – replace with your real submit form *@
        <form asp-area="Student" asp-controller="Exam" asp-action="Submit" method="post">
            <input type="hidden" name="attemptId" value="@attemptId" />
            <button type="submit" class="btn btn-success">Submit</button>
        </form>
    </div>
</div>
