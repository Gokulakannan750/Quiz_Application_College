@model Quiz_Application_College.Areas.Student.Controllers.StudentPanelsVm
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="row g-4">
        <!-- MCQ tile -->
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="card-title mb-2">MCQ Dashboard</h4>
                        <div class="text-muted">
                            <div>Available now: <strong>@Model.McqAvailableNow</strong></div>
                            <div>Upcoming (7 days): <strong>@Model.McqUpcoming</strong></div>
                        </div>
                    </div>
                    <a class="btn btn-primary"
                       href="/Student/MCQ">Open</a>
                </div>
            </div>
        </div>

        <!-- Coding tile -->
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="card-title mb-2">Coding Dashboard</h4>
                        <div class="text-muted">
                            <div>Available now: <strong>@Model.CodingAvailableNow</strong></div>
                            <div>Upcoming (7 days): <strong>@Model.CodingUpcoming</strong></div>
                        </div>
                    </div>
                    <a class="btn btn-secondary"
                       href="/Student/Coding">Open</a>
                </div>
            </div>
        </div>
    </div>
</div>
