@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">MCQ Quizzes</h5>
                        <p class="text-muted mb-0">All your MCQ quizzes available now.</p>
                    </div>
                    <a class="btn btn-primary" asp-area="Student" asp-controller="Dashboard" asp-action="Index" asp-route="" href="/Student/MCQ">Open</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Coding Quizzes</h5>
                        <p class="text-muted mb-0">All your Coding quizzes available now.</p>
                    </div>
                    <a class="btn btn-secondary" asp-area="Student" asp-controller="Dashboard" asp-action="Index" asp-route="" href="/Student/Coding">Open</a>
                </div>
            </div>
        </div>
    </div>
</div>
