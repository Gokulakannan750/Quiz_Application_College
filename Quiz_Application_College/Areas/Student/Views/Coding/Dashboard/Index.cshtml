@using System.Globalization
@model IEnumerable<Quiz_Application_College.Areas.Student.Controllers.Coding.AvailableTileVm>

@{
    ViewData["Title"] = "Coding — Available Quizzes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <a class="btn btn-outline-secondary" href="/Student">← Back to Student Dashboard</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No Coding quizzes are currently available for you. Please check again later.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:35%">Quiz</th>
                        <th style="width:15%">Duration</th>
                        <th style="width:25%">Window</th>
                        <th style="width:15%">Attempts</th>
                        <th style="width:10%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.OrderBy(x => x.EndAt))
                    {
                        var attemptsText = (q.MaxAttempts <= 0)
                        ? "—"
                        : $"{q.UsedAttempts} / {q.MaxAttempts}";
                        <tr>
                            <td><div class="fw-semibold">@q.Title</div></td>
                            <td>@q.DurationMinutes min</td>
                            <td class="text-nowrap">
                                <div><small class="text-muted">Start:</small> @q.StartAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</div>
                                <div><small class="text-muted">End:</small> @q.EndAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</div>
                            </td>
                            <td>@attemptsText</td>
                            <td class="text-end">
                                <!-- FIX: controller must be Attempt -->
                                <a class="btn btn-primary btn-sm"
                                   href="/Student/Coding/Start?quizId=@q.QuizId">
                                    Start
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
