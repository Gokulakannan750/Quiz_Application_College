@model Quiz_Application_College.Areas.Student.Controllers.Coding.ExamController.CodingExamVm
@{
    ViewData["Title"] = Model.ProblemTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-0">@Model.ProblemTitle</h3>
            <div class="text-muted">Duration: @Model.DurationMinutes min</div>
        </div>
        <a class="btn btn-outline-secondary" href="/Student/Coding">← Back to Coding Dashboard</a>
    </div>

    <form method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="quizId" value="@Model.QuizId" />

        <!-- Problem / Question -->
        <div class="card mb-3">
            <div class="card-header fw-semibold">Problem</div>
            <div class="card-body">
                <div class="alert alert-secondary mb-0" style="white-space:pre-wrap">@Model.Questions</div>
            </div>
        </div>

        <!-- Language + Editor -->
        <div class="card mb-3">
            <div class="card-header fw-semibold">Editor</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Language</label>
                    <select name="Language" class="form-select" asp-for="Language">
                        <option value="cpp" selected="@(Model.Language == "cpp")">C++</option>
                        <option value="c" selected="@(Model.Language == "c")">C</option>
                        <option value="python" selected="@(Model.Language == "python")">Python</option>
                        <option value="csharp" selected="@(Model.Language == "csharp")">C#</option>
                        <option value="java" selected="@(Model.Language == "java")">Java</option>
                    </select>
                </div>

                <label class="form-label">Your Code</label>
                <textarea id="code-editor" name="Code" rows="18" class="form-control" asp-for="Code"></textarea>
                <div class="form-text">Hidden testcases are NOT shown here; they will be used during grading.</div>
            </div>
        </div>

        <!-- ✅ Separate table named “Testcases” -->
        <div class="card mb-3">
            <div class="card-header fw-semibold">Testcases</div>
            <div class="card-body">
                @if (Model.SampleCases.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th style="width:70px">#</th>
                                    <th style="width:45%">Input</th>
                                    <th>Expected Output</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var n = 1;
                                    foreach (var s in Model.SampleCases)
                                    {
                                        <tr>
                                            <td class="text-muted">TC @n</td>
                                            <td><pre class="mb-0" style="white-space:pre-wrap">@s.Input</pre></td>
                                            <td><pre class="mb-0" style="white-space:pre-wrap">@s.ExpectedOutput</pre></td>
                                        </tr>
                                        n++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No public testcases available for this problem.
                    </div>
                }
            </div>
        </div>

        <!-- Review / Submit -->
        <div class="d-flex gap-2">
            @if (!Model.IsReview)
            {
                <button name="mode" value="review" class="btn btn-secondary">Review</button>
                <button name="mode" value="submit" class="btn btn-primary">Submit</button>
            }
            else
            {
                <button name="mode" value="back" class="btn btn-outline-secondary">Back to Edit</button>
                <button name="mode" value="submit" class="btn btn-success">Confirm Submit</button>
            }
        </div>
    </form>
</div>

<!-- Monaco loader (safe no-op if offline) -->
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.min.js"></script>
<script>
    (function () {
        const ta = document.getElementById('codeArea');
        if (!ta) return;

        // Lightweight Monaco boot – only if CDN loads
        window.require && window.require.config({ paths: { 'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
        window.require && window.require(['vs/editor/editor.main'], function () {
            const wrapper = document.createElement('div');
            wrapper.style.height = '420px';
            wrapper.className = 'border rounded';
            ta.parentNode.insertBefore(wrapper, ta);
            ta.style.display = 'none';

            const editor = monaco.editor.create(wrapper, {
                value: ta.value || '',
                language: (document.querySelector('[name="Language"]').value || 'cpp'),
                automaticLayout: true,
                minimap: { enabled: false }
            });

            // keep textarea in sync for form POST
            editor.onDidChangeModelContent(() => { ta.value = editor.getValue(); });

            // change language on dropdown
            const langSel = document.querySelector('[name="Language"]');
            langSel && langSel.addEventListener('change', () => {
                monaco.editor.setModelLanguage(editor.getModel(), langSel.value || 'cpp');
            });
        });
    })();
</script>
