@model IEnumerable<Quiz_Application_College.Areas.Student.Controllers.Mcq.DashboardController.McqAvailableVm>
@{
    ViewData["Title"] = "MCQ — Available Quizzes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">MCQ — Available Quizzes</h2>
        <a class="btn btn-outline-secondary" href="/Student">← Back to Student Dashboard</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th style="width:140px">Duration</th>
                    <th style="width:360px">Window</th>
                    <th style="width:110px">Attempts</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@q.Title</td>
                        <td>@q.DurationMinutes min</td>
                        <td>
                            <div class="text-muted">
                                <div>Start: @q.StartAt.ToString("dd MMM yyyy, HH:mm")</div>
                                <div>End: @q.EndAt.ToString("dd MMM yyyy, HH:mm")</div>
                            </div>
                        </td>
                        <td>@q.UsedAttempts / @q.MaxAttempts</td>
                        <td class="text-end">
                            @if (q.CanStart)
                            {
                                <a class="btn btn-primary btn-sm"
                                   href="/Student/MCQ/Exam/Play?quizId=@q.QuizId">Start</a>
                            }
                            else
                            {
                                <a class="btn btn-secondary btn-sm disabled"
                                   tabindex="-1" aria-disabled="true">Start</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
