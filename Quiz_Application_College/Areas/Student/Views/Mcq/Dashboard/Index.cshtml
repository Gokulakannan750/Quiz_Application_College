@model IEnumerable<Quiz_Application_College.Areas.Student.Controllers.Mcq.AvailableTileVm>
@{
    ViewData["Title"] = "MCQ - Available Quizzes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No MCQ quizzes are currently available.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var x in Model)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title mb-1">@x.Title</h5>
                            <div class="text-muted small">
                                @x.StartAt — @x.EndAt<br />
                                Attempts: @x.UsedAttempts / @x.MaxAttempts · Duration: @x.DurationMinutes min
                            </div>
                        </div>
                        <a class="btn btn-primary"
                           asp-area="Student"
                           asp-controller="Exam"
                           asp-action="Start"
                           asp-route-quizId="@x.QuizId"
                           asp-route-scheduleId="@x.ScheduleId">
                            Start
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
