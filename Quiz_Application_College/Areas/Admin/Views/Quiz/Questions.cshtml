@model IEnumerable<Quiz_Application_College.ViewModels.QuestionSelectVm>
@{
    ViewData["Title"] = "Assign Questions";
    var quizId = (Guid)ViewBag.QuizId;
    var quizTitle = (string)ViewBag.QuizTitle;
}

<h2>Assign Questions to: @quizTitle</h2>

@if (TempData["Info"] != null)
{
    <div class="alert alert-success">@TempData["Info"]</div>
}

<form asp-action="Questions" asp-route-id="@quizId" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(true)">Select All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">Clear All</button>
        <button type="submit" class="btn btn-primary ms-2">Save</button>
        <a asp-action="Index" class="btn btn-secondary ms-1">Back</a>
    </div>

    <ul class="list-group">
        @foreach (var q in Model)
        {
            <li class="list-group-item d-flex align-items-center">
                <input class="form-check-input me-2" type="checkbox"
                       name="selectedIds"
                       value="@q.QuestionId"
                       @(q.Selected ? "checked" : "") />
                <span>@q.Text</span>
                @if (q.Selected && q.Order.HasValue)
                {
                    <span class="badge bg-light text-muted ms-auto">Order: @q.Order</span>
                }
            </li>
        }
    </ul>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <script>
        function selectAll(flag) {
            document.querySelectorAll('input[name="selectedIds"]').forEach(cb => cb.checked = flag);
        }
    </script>
}
