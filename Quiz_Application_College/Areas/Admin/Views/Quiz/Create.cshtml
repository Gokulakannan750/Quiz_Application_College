@model Quiz_Application_College.ViewModels.QuizCreateVm
@{
    ViewData["Title"] = "Create Quiz";
}

<h2>Create Quiz</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="DurationMinutes" class="form-label"></label>
            <input asp-for="DurationMinutes" class="form-control" />
            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="TotalMarks" class="form-label"></label>
            <input asp-for="TotalMarks" class="form-control" />
            <span asp-validation-for="TotalMarks" class="text-danger"></span>
        </div>
        <div class="col-md-3 form-check align-self-end">
            <input asp-for="EnableNegativeMarking" class="form-check-input" />
            <label asp-for="EnableNegativeMarking" class="form-check-label">Enable Negative Marking</label>
        </div>
        <div class="col-md-3">
            <label asp-for="NegativeMarkPerWrong" class="form-label">Negative per Wrong</label>
            <input asp-for="NegativeMarkPerWrong" class="form-control" />
            <span class="form-text">Keep 0 when using 25% per-question mode.</span>
        </div>
    </div>

    <hr />
    <h5>Settings</h5>
    <div class="row">
        <div class="col-md-3 form-check">
            <input asp-for="ShuffleQuestions" class="form-check-input" />
            <label asp-for="ShuffleQuestions" class="form-check-label">Shuffle Questions</label>
        </div>
        <div class="col-md-3 form-check">
            <input asp-for="ShuffleOptions" class="form-check-input" />
            <label asp-for="ShuffleOptions" class="form-check-label">Shuffle Options</label>
        </div>
        <div class="col-md-3 form-check">
            <input asp-for="ShowReviewOnSubmit" class="form-check-input" />
            <label asp-for="ShowReviewOnSubmit" class="form-check-label">Show Review on Submit</label>
        </div>
        <div class="col-md-3 form-check">
            <input asp-for="ShowScoreOnSubmit" class="form-check-input" />
            <label asp-for="ShowScoreOnSubmit" class="form-check-label">Show Score on Submit</label>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
