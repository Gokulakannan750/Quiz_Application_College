@model Quiz_Application_College.ViewModels.McqEditVm
@{
    ViewData["Title"] = "Edit MCQ Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Edit MCQ Question</h2>
        <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank">Back</a>
    </div>

    <form method="post" action="/Admin/MCQ/QuestionBank/Edit/@Model.Id">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm">
            <div class="card-body">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Question Text</label>
                    <textarea asp-for="Text" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Text" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Marks</label>
                        <input asp-for="Marks" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Marks" class="text-danger"></span>
                    </div>
                </div>

                <hr />
                <h6 class="mb-2">Options (mark exactly one as correct)</h6>

                @for (int i = 0; i < Model.Options.Count; i++)
                {
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-1 text-end"><strong>@(i + 1).</strong></div>
                        <div class="col-8">
                            <input type="hidden" name="Options[@i].Id" value="@Model.Options[i].Id" />
                            <input name="Options[@i].Text" class="form-control" value="@Model.Options[i].Text" />
                        </div>
                        <div class="col-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Options[@i].IsCorrect" value="true" @(Model.Options[i].IsCorrect ? "checked" : "") />
                                <input type="hidden" name="Options[@i].IsCorrect" value="false" />
                                <label class="form-check-label">Correct</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
