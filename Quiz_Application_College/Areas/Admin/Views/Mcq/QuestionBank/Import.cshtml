@model Quiz_Application_College.ViewModels.QuestionImportVm
@{
    ViewData["Title"] = "Import MCQ Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var quizSelect = Model.Quizzes ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Import MCQ Questions</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank/Template">Download Template</a>
            <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank">Back</a>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" action="/Admin/MCQ/QuestionBank/Import">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Upload .xlsx file</label>
                    <input type="file" name="file" class="form-control" accept=".xlsx" />
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="AssignToQuiz" />
                    <label class="form-check-label" asp-for="AssignToQuiz">Assign imported questions to this quiz</label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Quiz (optional)</label>
                    <select asp-for="QuizId" asp-items="quizSelect" class="form-select">
                        <option value="">-- Select quiz --</option>
                    </select>
                    <span asp-validation-for="QuizId" class="text-danger"></span>
                </div>

                @if (Model.Errors?.Count > 0)
                {
                    <div class="alert alert-warning">
                        <strong>Import Warnings/Errors:</strong>
                        <ul class="mb-0">
                            @foreach (var err in Model.Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.TotalRows > 0)
                {
                    <div class="alert alert-info mt-2">
                        File: <strong>@Model.FileName</strong> — Rows: <strong>@Model.TotalRows</strong>,
                        Inserted: <strong>@Model.Inserted</strong>, Skipped: <strong>@Model.Skipped</strong>
                    </div>
                }

            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Start Import</button>
                <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
