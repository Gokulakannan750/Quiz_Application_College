@model IList<Quiz_Application_College.ViewModels.QuestionSelectVm>
@{
    ViewData["Title"] = "Select MCQ Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var quizId = (Guid)ViewBag.QuizId;
    var quizTitle = (string)ViewBag.QuizTitle ?? "Quiz";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Select Questions — @quizTitle</h2>
        <a class="btn btn-outline-secondary" href="/Admin/MCQ/Quiz">Back</a>
    </div>

    <form method="post" action="/Admin/MCQ/Quiz/Questions/@quizId">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width:60px;">Use</th>
                                <th>Question</th>
                                <th style="width:120px;">Order</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="selectedIds" value="@Model[i].QuestionId" @(Model[i].Selected ? "checked" : "") />
                                        </td>
                                        <td>@Model[i].Text</td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" value="@(Model[i].Order ?? 0)" disabled />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted">No questions found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Selection</button>
                <a class="btn btn-outline-secondary" href="/Admin/MCQ/Quiz">Cancel</a>
            </div>
        </div>
    </form>
</div>
