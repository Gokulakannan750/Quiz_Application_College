@model Quiz_Application_College.ViewModels.StudentEnrolledBrowseVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "MCQ — Filter & Enroll Students";
}

<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0">MCQ — Filter & Enroll Students</h2>
    <a asp-route="AdminMcqEnrollmentIndex" class="btn btn-outline-secondary ms-auto">Back</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<form asp-route="AdminMcqEnrollmentCreate" method="get" class="card mb-3 p-3">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">College</label>
            @Html.DropDownListFor(m => m.College, Model.CollegeOptions, "All", new { @class = "form-select" })
        </div>
        <div class="col-md-4">
            <label class="form-label">Department</label>
            @Html.DropDownListFor(m => m.Department, Model.DepartmentOptions, "All", new { @class = "form-select" })
        </div>
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input asp-for="Search" class="form-control" placeholder="name / roll / email" />
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-route="AdminMcqEnrollmentCreate" class="btn btn-outline-secondary">Clear</a>
    </div>

    <input type="hidden" asp-for="Page" />
    <input type="hidden" asp-for="PageSize" />
</form>

<form asp-route="AdminMcqEnrollmentCreate" method="post" class="card p-3 mb-3">
    @Html.AntiForgeryToken()
    <div class="mb-2 fw-semibold">Enroll all FILTERED students to schedule</div>
    <select name="scheduleId" class="form-select mb-2" asp-items="ViewBag.ScheduleOptions">
        <option value="">-- Select Schedule --</option>
    </select>

    @* Only render summary when there are errors (removes the stray blue dot) *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    }

    <button type="submit" class="btn btn-success">Enroll Filtered</button>

    @* Preserve filters on POST *@
    <input type="hidden" asp-for="College" />
    <input type="hidden" asp-for="Department" />
    <input type="hidden" asp-for="Search" />
    <input type="hidden" asp-for="Page" />
    <input type="hidden" asp-for="PageSize" />
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>College</th>
                    <th>Dept</th>
                    <th>Roll</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Rows != null && Model.Rows.Any())
                {
                    foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.College</td>
                            <td>@r.Department</td>
                            <td>@r.RollNumber</td>
                            <td>@r.Name</td>
                            <td>@r.Email</td>
                            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted">No students found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2 p-2">
        @{
            var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
            var pageNo = Math.Clamp(Model.Page, 1, totalPages);
            Func<int, string> link = p => Url.RouteUrl("AdminMcqEnrollmentCreate", new
            {
                College = Model.College,
                Department = Model.Department,
                Search = Model.Search,
                Page = p,
                PageSize = Model.PageSize
            }) ?? "#";
        }
        <span class="align-self-center me-2">Page @(pageNo) of @(totalPages)</span>
        <a class="btn btn-sm btn-outline-secondary @(pageNo == 1 ? "disabled" : "")" href="@(pageNo == 1 ? "#" : link(1))">First</a>
        <a class="btn btn-sm btn-outline-secondary @(pageNo == 1 ? "disabled" : "")" href="@(pageNo == 1 ? "#" : link(pageNo - 1))">Prev</a>
        <a class="btn btn-sm btn-outline-secondary @(pageNo == totalPages ? "disabled" : "")" href="@(pageNo == totalPages ? "#" : link(pageNo + 1))">Next</a>
        <a class="btn btn-sm btn-outline-secondary @(pageNo == totalPages ? "disabled" : "")" href="@(pageNo == totalPages ? "#" : link(totalPages))">Last</a>
    </div>
</div>
