@model IEnumerable<Quiz_Application_College.Domain.Enrollment>
@{
    ViewData["Title"] = "Enrollments";
    var emails = (IDictionary<string, string>)ViewBag.UserEmails;
}
<h2>Enrollments</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Add Enrollment</a>
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No enrollments yet. Click <a asp-action="Create">Add Enrollment</a>.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Quiz</th>
                <th>User</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Quiz?.Title</td>
                    <td>@(emails.TryGetValue(e.UserId, out var mail) ? mail : e.UserId)</td>
                    <td>@e.Status</td>
                    <td>
                        <form asp-action="Delete" method="post" asp-route-id="@e.Id" onsubmit="return confirm('Remove this enrollment?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </form>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
