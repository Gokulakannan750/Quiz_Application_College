@model IEnumerable<dynamic>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "MCQ — Enrollments";
}
<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0">MCQ — Enrollments</h2>
    <a asp-route="AdminMcqEnrollmentCreate" class="btn btn-primary ms-auto">Enroll Students</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>Roll</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Enrolled At</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.QuizTitle</td>
                            <td>@e.Roll</td>
                            <td>@e.Name</td>
                            <td>@e.Email</td>
                            <td>@(((DateTimeOffset)e.CreatedAt).ToLocalTime().ToString("g"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted">No enrollments found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
