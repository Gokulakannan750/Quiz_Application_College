@model Quiz_Application_College.ViewModels.McqCreateVm
@{
    ViewData["Title"] = "Create MCQ Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Create MCQ Question</h2>
        <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank">Back</a>
    </div>

    <form method="post" action="/Admin/MCQ/QuestionBank/Create">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Question Text</label>
                    <textarea asp-for="Text" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Text" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Marks</label>
                        <input asp-for="Marks" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Marks" class="text-danger"></span>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">Tag (optional)</label>
                        <input asp-for="Tag" class="form-control" />
                        <span asp-validation-for="Tag" class="text-danger"></span>
                    </div>
                </div>

                <hr />
                <h6 class="mb-2">Options</h6>

                @for (int i = 0; i < Model.Options.Length; i++)
                {
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-1 text-end"><strong>@( (char)('A' + i) ).</strong></div>
                        <div class="col-9">
                            <input name="Options[@i]" class="form-control" />
                        </div>
                        <div class="col-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="CorrectIndex" value="@i" />
                                <label class="form-check-label">Correct</label>
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a class="btn btn-outline-secondary" href="/Admin/MCQ/QuestionBank">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
