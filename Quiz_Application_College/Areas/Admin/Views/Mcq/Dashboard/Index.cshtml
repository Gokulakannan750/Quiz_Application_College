@{
    ViewData["Title"] = "MCQ Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">MCQ Dashboard</h2>
        <a class="btn btn-outline-secondary" href="/Admin">Back to Main</a>
    </div>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/MCQ/Quiz/Index">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Quizzes</h5>
                        <p class="card-text text-muted">Create & manage MCQ quizzes.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/MCQ/Schedule/Index">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Schedules</h5>
                        <p class="card-text text-muted">Time windows for MCQ quizzes.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/MCQ/Enrollment/Index">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Enrolments</h5>
                        <p class="card-text text-muted">Enroll students to MCQ quizzes.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <a class="text-decoration-none" href="/Admin/MCQ/QuestionBank/Index">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Question Bank</h5>
                        <p class="card-text text-muted">Create/import MCQ questions.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
