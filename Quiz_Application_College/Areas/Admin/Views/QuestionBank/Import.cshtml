@model Quiz_Application_College.ViewModels.QuestionImportVm
@{
    ViewData["Title"] = "Import Questions";
}

<h2>Import Questions (.xlsx)</h2>
<p class="text-muted">Download the template, fill your questions, then upload.</p>

<div class="mb-3">
    <a class="btn btn-outline-secondary" asp-action="Template">Download Template</a>
</div>

<form asp-action="Import" method="post" enctype="multipart/form-data" class="card p-3 mb-4">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <label for="file" class="form-label">Excel file (.xlsx)</label>
            <input type="file" class="form-control" id="file" name="file" accept=".xlsx" required />
        </div>

        <div class="col-md-6">
            <div class="form-check mt-4">
                <input asp-for="AssignToQuiz" class="form-check-input" id="AssignToQuiz" />
                <label for="AssignToQuiz" class="form-check-label">Assign imported questions to a quiz</label>
            </div>
            <label class="form-label mt-2">Quiz</label>
            <select asp-for="QuizId" asp-items="Model.Quizzes" class="form-select" id="QuizId"></select>
            <small class="text-muted">If enabled, each imported question will be appended to the selected quiz.</small>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Upload & Import</button>
        <a class="btn btn-secondary" asp-action="Index">Back to Question Bank</a>
    </div>
</form>

@if (Model != null && Model.HasResult)
{
    <div class="card">
        <div class="card-header fw-semibold">Import Result</div>
        <div class="card-body">
            <p>
                File: <strong>@Model.FileName</strong><br />
                Rows read: <strong>@Model.TotalRows</strong><br />
                Inserted: <strong class="text-success">@Model.Inserted</strong><br />
                Skipped: <strong class="text-danger">@Model.Skipped</strong>
            </p>

            @if (Model.Errors != null && Model.Errors.Any())
            {
                <div class="alert alert-warning">
                    <div class="fw-semibold mb-2">Issues</div>
                    <ul>
                        @foreach (var e in Model.Errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            }

            <a class="btn btn-secondary" asp-action="Index">Back to Question Bank</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleQuizSelect() {
            const chk = document.getElementById('AssignToQuiz');
            const sel = document.getElementById('QuizId');
            sel.disabled = !chk.checked;
        }
        document.getElementById('AssignToQuiz').addEventListener('change', toggleQuizSelect);
        toggleQuizSelect(); // initial
    </script>
}
