@model Quiz_Application_College.ViewModels.McqEditVm
@{
    ViewData["Title"] = "Edit Question";
}

<h2>Edit Question</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Text" class="form-label"></label>
        <textarea asp-for="Text" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <div class="mb-3 col-md-3">
        <label asp-for="Marks" class="form-label"></label>
        <input asp-for="Marks" class="form-control" />
        <span asp-validation-for="Marks" class="text-danger"></span>
    </div>

    <h5>Options</h5>
    <table class="table">
        <thead>
            <tr><th>Text</th><th>Correct</th><th></th></tr>
        </thead>
        <tbody id="opts">
            @for (int i = 0; i < Model.Options.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden" asp-for="Options[@i].Id" />
                        <input asp-for="Options[@i].Text" class="form-control" />
                        <span asp-validation-for="Options[@i].Text" class="text-danger"></span>
                    </td>
                    <td class="text-center">
                        <input asp-for="Options[@i].IsCorrect" class="form-check-input"
                               onclick="ensureSingleCorrect(this)" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary" onclick="addOption()">Add Option</button>
        <small class="text-muted">Exactly one option must be marked <strong>Correct</strong>.</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function ensureSingleCorrect(chk) {
            // uncheck all siblings
            document.querySelectorAll('#opts input[type=checkbox]').forEach(c => {
                if (c !== chk) c.checked = false;
            });
        }
        function removeRow(btn) {
            const tr = btn.closest('tr');
            tr.remove();
        }
        function addOption() {
            const tbody = document.getElementById('opts');
            const index = tbody.querySelectorAll('tr').length;
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>
                    <input name="Options[${index}].Id" type="hidden" />
                    <input name="Options[${index}].Text" class="form-control" />
                </td>
                <td class="text-center">
                    <input name="Options[${index}].IsCorrect" type="checkbox" class="form-check-input"
                           onclick="ensureSingleCorrect(this)" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)">Remove</button>
                </td>`;
            tbody.appendChild(row);
        }
    </script>
}
