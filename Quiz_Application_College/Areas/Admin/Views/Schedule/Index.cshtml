@model IEnumerable<Quiz_Application_College.Domain.QuizSchedule>
@{
    ViewData["Title"] = "Schedules";
}

<div class="container mt-3">
    <h2>Schedules</h2>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }

    <div class="mb-3">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Schedule" asp-action="Create">
            Create Schedule
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Max Attempts</th>
                    <th style="width:130px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Quiz?.Title</td>
                        <td>@s.StartAt.ToLocalTime()</td>
                        <td>@s.EndAt.ToLocalTime()</td>
                        <td>@s.MaxAttempts</td>
                        <td>
                            <form asp-area="Admin" asp-controller="Schedule" asp-action="Delete"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this schedule?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="quizId" value="@s.QuizId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
