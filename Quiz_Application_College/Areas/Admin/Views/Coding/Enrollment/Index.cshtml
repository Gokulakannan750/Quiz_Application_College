@model IEnumerable<Quiz_Application_College.ViewModels.Coding.EnrollmentRowVm>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Coding — Enrollments";
}
<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0">Coding — Enrollments</h2>
    <a asp-route="AdminCodingEnrollmentCreate" class="btn btn-primary ms-auto">Enroll Students</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.QuizTitle</td>
                            <td>@e.UserId</td>
                            <td>@e.Email</td>
                            <td>@e.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Enrollment" asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-area="Admin" asp-controller="Enrollment" asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this enrollment?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted">No enrollments found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
