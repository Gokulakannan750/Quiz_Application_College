@model IEnumerable<Quiz_Application_College.Areas.Admin.Controllers.Coding.CodingQuizController.LanguageFolderVm>

@{
    ViewData["Title"] = "Coding Quiz Languages";
}

<h2 class="mb-3">Coding Quiz Languages</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">

    <!-- CREATE FOLDER CARD -->
    <div class="col-12 col-md-4">
        <form method="post"
              asp-area="Admin"
              asp-controller="CodingQuiz"
              asp-action="CreateLanguageFolder"
              class="card shadow-sm h-100">
            @Html.AntiForgeryToken()

            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Create New Language Folder</h5>
                <p class="text-muted small">
                    Enter a programming language name to create a quiz folder.
                </p>

                <input class="form-control mb-3"
                       type="text"
                       name="languageName"
                       placeholder="e.g. C Programming"
                       required />

                <button type="submit" class="btn btn-primary mt-auto">
                    Create Folder
                </button>
            </div>
        </form>
    </div>

    <!-- EXISTING FOLDERS -->
    @foreach (var f in Model)
    {
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@f.Name</h5>
                    <p class="text-muted small">
                        Quizzes: @f.QuizCount<br />
                        Published: @f.PublishedCount
                    </p>

                    <a asp-area="Admin"
                       asp-controller="CodingQuiz"
                       asp-action="ByLanguage"
                       asp-route-language="@f.Name"
                       class="btn btn-primary mt-auto">
                        Open Folder
                    </a>
                </div>
            </div>
        </div>
    }
</div>
