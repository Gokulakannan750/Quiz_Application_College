@using Quiz_Application_College.Areas.Admin.Controllers.Coding
@model List<CodingQuizController.QuizRowVm>

@{
    var language = ViewBag.Language as string ?? "Uncategorized";
    ViewData["Title"] = $"Coding Quizzes – {language}";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">
            Quizzes for @language. Manage questions and publish status.
        </p>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary me-2">
            ← All Languages
        </a>
        <a asp-action="Create"
           asp-route-language="@language"
           class="btn btn-primary">
            + New Quiz in @language
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No coding quizzes found for @language.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var q in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <!-- Header: title + status badge -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-1">@q.Title</h5>
                                <p class="text-muted mb-1">
                                    Duration: @q.DurationMinutes min<br />
                                    Created: @q.CreatedAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm")
                                </p>
                                <p class="mb-0">
                                    <strong>Questions:</strong> @q.QuestionCount
                                </p>
                            </div>
                            <div>
                                @if (q.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </div>
                        </div>

                        <!-- Spacer so buttons stick to bottom -->
                        <div class="mt-auto pt-3 border-top">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <!-- Left: primary Questions button -->
                                <a asp-action="ManageQuestions"
                                   asp-route-id="@q.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Questions
                                </a>

                                <!-- Right: Edit + Publish/Unpublish + Delete -->
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@q.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        Edit
                                    </a>

                                    @if (q.IsPublished)
                                    {
                                        <form asp-action="Unpublish"
                                              asp-route-id="@q.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning btn-sm">
                                                Unpublish
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Publish"
                                              asp-route-id="@q.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm">
                                                Publish
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="Delete"
                                          asp-route-id="@q.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
