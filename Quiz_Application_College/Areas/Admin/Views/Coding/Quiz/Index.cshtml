@model IEnumerable<Quiz_Application_College.Domain.Quiz>
@{
    ViewData["Title"] = "Coding Quizzes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Coding Quizzes</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="/Admin/Coding/Quiz/Create">Create Quiz</a>
            <a class="btn btn-outline-secondary" href="/Admin/Coding">Back to Coding Dashboard</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Duration</th>
                            <th>Total Marks</th>
                            <th>Published</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var q in Model)
                            {
                                <tr>
                                    <td>@q.Title</td>
                                    <td>@q.DurationMinutes mins</td>
                                    <td>
                                        @q.TotalMarks
                                        <small class="text-muted">(by testcases)</small>
                                    </td>
                                    <td>@(q.IsPublished ? "Yes" : "No")</td>
                                    <td>@q.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" href="/Admin/Coding/Quiz/Edit/@q.Id">Edit</a>

                                        <a class="btn btn-outline-info btn-sm ms-1"
                                           href="~/Admin/Coding/Quiz/ManageQuestions/@q.Id">Questions</a>

                                        <form method="post" action="/Admin/Coding/Quiz/@(q.IsPublished ? "Unpublish" : "Publish")/@q.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(q.IsPublished ? "btn-warning" : "btn-success")">
                                                @(q.IsPublished ? "Unpublish" : "Publish")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted">No coding quizzes yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
