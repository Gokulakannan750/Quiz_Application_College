@model Quiz_Application_College.Domain.Coding.CodeQuestion
@{
    ViewData["Title"] = "New Coding Question";
    var cases = (Model?.TestCases ?? new List<Quiz_Application_College.Domain.Coding.CodeTestCase>()).ToList();
    if (cases.Count == 0) { cases.Add(new Quiz_Application_College.Domain.Coding.CodeTestCase { IsHidden = false, Weight = 1 }); }
}

@if (!ViewData.ModelState.IsValid)
{
    var errors = ViewData.ModelState.Where(kv => kv.Value.Errors.Count > 0)
        .Select(kv => new { Key = kv.Key, Msg = string.Join(" | ", kv.Value.Errors.Select(e => e.ErrorMessage)) })
        .ToList();

    if (errors.Any())
    {
        <div class="alert alert-danger">
            <strong>Validation errors</strong>
            <ul>
                @foreach (var e in errors)
                {
                    <li><code>@e.Key</code> — @e.Msg</li>
                }
            </ul>
        </div>
    }
}

<div class="container mt-3">
    <h3>New Coding Question</h3>

    <form asp-area="Admin" asp-controller="CodeQuestions" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-2">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label class="form-label">Prompt</label>
            <textarea asp-for="Prompt" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Prompt" class="text-danger"></span>
        </div>

        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label">Max Marks</label>
                <input asp-for="MaxMarks" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="MaxMarks" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label class="form-label">Allowed Languages (CSV)</label>
                <input asp-for="AllowedLanguagesCsv" class="form-control" />
                <span asp-validation-for="AllowedLanguagesCsv" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label class="form-label">Starter Code (JSON map: {"python":"...","csharp":"..."})</label>
            <textarea asp-for="StarterCodeJson" class="form-control" rows="4"></textarea>
        </div>

        <hr class="my-3" />
        <h5>Test Cases</h5>
        <div id="cases">
            @for (int i = 0; i < cases.Count; i++)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label">Input</label>
                            <textarea name="TestCases[@i].Input" class="form-control" rows="2">@cases[i].Input</textarea>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Expected Output</label>
                            <textarea name="TestCases[@i].ExpectedOutput" class="form-control" rows="2">@cases[i].ExpectedOutput</textarea>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Weight</label>
                            <input name="TestCases[@i].Weight" class="form-control" type="number" step="1" value="@cases[i].Weight" />
                            <div class="form-check mt-2">
                                <!-- Hidden false value ensures proper bool binding -->
                                <input type="hidden" name="TestCases[@i].IsHidden" value="false" />
                                <input class="form-check-input" type="checkbox" name="TestCases[@i].IsHidden" value="true" @(cases[i].IsHidden ? "checked" : null) />
                                <label class="form-check-label">Hidden</label>
                            </div>
                        </div>
                        
                    </div>
                </div>
                
            }
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addCase()">+ Add Case</button>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-area="Admin" asp-controller="CodeQuestions" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let idx = @cases.Count;
        function addCase(){
          const html = `
            <div class="border rounded p-2 mb-2">
              <div class="row g-2">
                <div class="col-md-5">
                  <label class="form-label">Input</label>
                  <textarea name="TestCases[${idx}].Input" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-5">
                  <label class="form-label">Expected Output</label>
                  <textarea name="TestCases[${idx}].ExpectedOutput" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-2">
                  <label class="form-label">Weight</label>
                  <input name="TestCases[${idx}].Weight" class="form-control" type="number" step="1" value="1" />
                  <div class="form-check mt-2">
        <input type="hidden" name="TestCases[${idx}].IsHidden" value="false" />
        <input class="form-check-input" type="checkbox" name="TestCases[${idx}].IsHidden" value="true" />
                            <label class="form-check-label">Hidden</label>
                  </div>
                </div>
              </div>
            </div>`;
          document.getElementById('cases').insertAdjacentHTML('beforeend', html);
          idx++;
        }
    </script>
}
