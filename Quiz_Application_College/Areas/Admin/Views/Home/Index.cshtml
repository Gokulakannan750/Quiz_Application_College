@using Microsoft.EntityFrameworkCore
@inject Quiz_Application_College.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = "Admin Dashboard";
    var totalQuizzes = Db.Quizzes.Count();
    var openSchedules = Db.QuizSchedules
        .Count(s => s.StartAt <= DateTimeOffset.UtcNow && s.EndAt >= DateTimeOffset.UtcNow);
    var totalEnrollments = Db.Enrollments.Count();
}

<div class="container mt-3">
    <h2>Admin Dashboard</h2>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Quizzes</div>
                    <h3 class="my-2">@totalQuizzes</h3>
                    <a asp-area="Admin" asp-controller="Quiz" asp-action="Index" class="stretched-link">Open quiz list →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Open Schedules (Now)</div>
                    <h3 class="my-2">@openSchedules</h3>
                    <a asp-area="Admin" asp-controller="Schedule" asp-action="Index" class="stretched-link">View schedules →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Enrollments</div>
                    <h3 class="my-2">@totalEnrollments</h3>
                    <a asp-area="Admin" asp-controller="Enrollment" asp-action="Index" class="stretched-link">Manage enrollments →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Reports</div>
                    <h3 class="my-2">Manage</h3>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="stretched-link">
                        Create/Edit reports →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
