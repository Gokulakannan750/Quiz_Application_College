@model Quiz_Application_College.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .tile-link {
        text-decoration: none;
        color: inherit;
    }

    .tile-card {
        transition: transform .08s ease, box-shadow .08s ease;
        cursor: pointer;
    }

        .tile-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)
        }
</style>

<div class="container mt-3">
    <h2 class="mb-3">Admin Dashboard</h2>

    <!-- Summary tiles (CLICKABLE) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="Quiz" asp-action="Index" class="tile-link">
                <div class="card shadow-sm tile-card">
                    <div class="card-body">
                        <div class="text-muted small">Total Quizzes</div>
                        <div class="fs-4">@Model?.TotalQuizzes</div>
                        <div class="small text-primary mt-1">Open quiz list →</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="Schedule" asp-action="Index" class="tile-link">
                <div class="card shadow-sm tile-card">
                    <div class="card-body">
                        <div class="text-muted small">Open Schedules (Now)</div>
                        <div class="fs-4">@Model?.OpenSchedulesNow</div>
                        <div class="small text-primary mt-1">View schedules →</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="Enrollment" asp-action="Index" class="tile-link">
                <div class="card shadow-sm tile-card">
                    <div class="card-body">
                        <div class="text-muted small">Total Enrollments</div>
                        <div class="fs-4">@Model?.TotalEnrollments</div>
                        <div class="small text-primary mt-1">Manage enrollments →</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Coding Questions tile row -->

        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="CodeQuestions" asp-action="Index" class="tile-link">
                <div class="card shadow-sm tile-card">
                    <div class="card-body">
                        <div class="text-muted small">Coding Questions</div>
                        <div class="fs-4">Manage</div>
                        <div class="small text-primary mt-1">Create/Edit coding questions →</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Enrollments -->
    <h5 class="mt-4">Recent Enrollments</h5>
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Student</th>
                <th>Quiz</th>
                <th>Enrolled At</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.RecentEnrollments != null && Model.RecentEnrollments.Any())
            {
                foreach (var en in Model.RecentEnrollments)
                {
                    <tr>
                        <td>@en.Email</td>
                        <td>@en.QuizTitle</td>
                        <td>@en.CreatedAt.LocalDateTime</td>
                        <td>@en.Status</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-muted">No enrollments.</td></tr>
            }
        </tbody>
    </table>

    <!-- Recent Attempts -->
    <h5 class="mt-4">Recent Attempts</h5>
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Student</th>
                <th>Quiz</th>
                <th>Started</th>
                <th>Submitted</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.RecentAttempts != null && Model.RecentAttempts.Any())
            {
                foreach (var at in Model.RecentAttempts)
                {
                    <tr>
                        <td>@at.Email</td>
                        <td>@at.QuizTitle</td>
                        <td>@at.StartedAt.LocalDateTime</td>
                        <td>@(at.SubmittedAt?.LocalDateTime.ToString() ?? "-")</td>
                        <td>@at.Score</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-muted">No attempts.</td></tr>
            }
        </tbody>
    </table>
</div>
